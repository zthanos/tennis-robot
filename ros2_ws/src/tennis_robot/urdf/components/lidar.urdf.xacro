<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- SLAMTEC RPLIDAR C1 (datasheet v1.1, 2024-03-12):
         body 55.6 x 55.6 x 41.3 mm, lower base 23.1 mm, 110 g,
         scan (emit/receive) plane 29.8 mm above the mounting face,
         range 0.05-12 m.
       lidar_link = the mounting face (bottom of the sensor), so
         ground_scan_z = base_link_height + mount z + scan_offset_z.
       gpu_lidar renders VISUALS, and a ray origin inside its own housing hits
       the housing interior (blind lidar). The head is therefore drawn as the
       official 23.1 mm base plus a thin top cap, leaving an optical window
       around the scan plane. The window band (23.1..35.5 mm) is a sim-only
       simplification of the real rotating window, not a datasheet value.
       The support is the P2-99b pedestal in components/p297_tower.urdf.xacro,
       not a mast on this link. -->
  <xacro:macro name="rplidar_c1_mount"
               params="parent link_name xyz rpy update_rate scan_offset_z:=0.0298 mass:=0.110">
    <xacro:property name="c1_side" value="0.0556"/>
    <xacro:property name="c1_height" value="0.0413"/>
    <xacro:property name="c1_base_h" value="0.0231"/>
    <xacro:property name="c1_window_top" value="0.0355"/>
    <link name="${link_name}">
      <!-- SLAMTEC datasheet 110 g (P2-99c step c), centred in the body. -->
      <inertial>
        <origin xyz="0 0 ${c1_height / 2.0}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${mass * (c1_side ** 2 + c1_height ** 2) / 12.0}" ixy="0" ixz="0"
                 iyy="${mass * (c1_side ** 2 + c1_height ** 2) / 12.0}" iyz="0"
                 izz="${mass * c1_side ** 2 / 6.0}"/>
      </inertial>
      <visual name="head_base_vis">
        <origin xyz="0 0 ${c1_base_h / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${c1_side} ${c1_side} ${c1_base_h}"/></geometry>
        <material name="sensor_black"/>
      </visual>
      <visual name="head_cap_vis">
        <origin xyz="0 0 ${(c1_window_top + c1_height) / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${c1_side} ${c1_side} ${c1_height - c1_window_top}"/></geometry>
        <material name="sensor_black"/>
      </visual>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${link_name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <gazebo reference="${link_name}">
      <sensor name="front_lidar" type="gpu_lidar">
        <!-- Scan plane = 29.8 mm above the mounting face (THIS OFFSET IS PART
             OF THE HEIGHT DATUM), inside the open window between the base
             and the cap visuals above. -->
        <pose>0 0 ${scan_offset_z} 0 0 0</pose>
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/gz/lidar</topic>
        <gz_frame_id>${link_name}</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>500</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265358979</min_angle>
              <max_angle>3.14159265358979</max_angle>
            </horizontal>
          </scan>
          <range>
            <!-- RPLIDAR C1 spec min is 0.05 m. The sim keeps 0.15 m to reject
                 residual self-hits from the robot body (P2-99a/P2-99c). -->
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
