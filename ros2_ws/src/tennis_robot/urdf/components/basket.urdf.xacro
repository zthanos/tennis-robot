<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Ball collection basket (floor + three walls), fixed to parent link.
       floor_front_x: forward edge of the floor (base_link x). Must stay clear
         of the intake wheel span (nip_x - wheel radius) or it overhangs the
         wheel-to-hopper handoff and caps the ball's climb (debug-log #41).
       floor_top_z_ground: floor top height in the GROUND frame. The scoop-era
         launch design used 0.128; the dual-wheel transport concept wants a low
         hopper entry just above the chassis plate (~0.058). -->
  <xacro:macro name="ball_basket" params="parent floor_front_x floor_top_z_ground">
    <!-- basket_link shares base_link's origin (45 mm above ground). -->
    <xacro:property name="floor_top" value="${floor_top_z_ground - base_link_height}"/>
    <xacro:property name="floor_thickness" value="0.020"/>
    <xacro:property name="floor_rear_x" value="-0.12"/>
    <xacro:property name="wall_top" value="0.353"/>
    <joint name="basket_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="basket_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="basket_link">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>

      <collision name="basket_floor_col">
        <origin xyz="${(floor_front_x + floor_rear_x) / 2.0} 0 ${floor_top - floor_thickness / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${floor_front_x - floor_rear_x} 0.34 ${floor_thickness}"/></geometry>
      </collision>
      <visual name="basket_floor_vis">
        <origin xyz="${(floor_front_x + floor_rear_x) / 2.0} 0 ${floor_top - floor_thickness / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${floor_front_x - floor_rear_x} 0.34 ${floor_thickness}"/></geometry>
        <material name="basket_gray"/>
      </visual>

      <!-- Walls run from the floor top up to a fixed rim so lowering the
           floor cannot open a gap balls could escape through. -->
      <collision name="basket_left_wall_col">
        <origin xyz="0.15 0.17 ${(wall_top + floor_top - floor_thickness) / 2.0}" rpy="0 0 0"/>
        <geometry><box size="0.54 0.020 ${wall_top - floor_top + floor_thickness}"/></geometry>
      </collision>
      <visual name="basket_left_wall_vis">
        <origin xyz="0.15 0.17 ${(wall_top + floor_top - floor_thickness) / 2.0}" rpy="0 0 0"/>
        <geometry><box size="0.54 0.020 ${wall_top - floor_top + floor_thickness}"/></geometry>
        <material name="basket_gray"/>
      </visual>

      <collision name="basket_right_wall_col">
        <origin xyz="0.15 -0.17 ${(wall_top + floor_top - floor_thickness) / 2.0}" rpy="0 0 0"/>
        <geometry><box size="0.54 0.020 ${wall_top - floor_top + floor_thickness}"/></geometry>
      </collision>
      <visual name="basket_right_wall_vis">
        <origin xyz="0.15 -0.17 ${(wall_top + floor_top - floor_thickness) / 2.0}" rpy="0 0 0"/>
        <geometry><box size="0.54 0.020 ${wall_top - floor_top + floor_thickness}"/></geometry>
        <material name="basket_gray"/>
      </visual>

      <collision name="basket_rear_wall_col">
        <origin xyz="-0.12 0 ${(wall_top + floor_top - floor_thickness) / 2.0}" rpy="0 0 0"/>
        <geometry><box size="0.020 0.34 ${wall_top - floor_top + floor_thickness}"/></geometry>
      </collision>
      <visual name="basket_rear_wall_vis">
        <origin xyz="-0.12 0 ${(wall_top + floor_top - floor_thickness) / 2.0}" rpy="0 0 0"/>
        <geometry><box size="0.020 0.34 ${wall_top - floor_top + floor_thickness}"/></geometry>
        <material name="basket_gray"/>
      </visual>

      <!-- Matches basket_ir_z in tennis_robot.urdf.xacro: beam at rolling
           ball equator height in the low hopper (0.085 ground). -->
      <visual name="basket_ir_beam_line_vis">
        <origin xyz="0.28 0 0.040" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.003" length="0.21"/></geometry>
        <material name="ir_beam_red"/>
      </visual>
    </link>
  </xacro:macro>
</robot>
