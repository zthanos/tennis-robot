<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Bin v2 (docs/basket-bin-redesign-spec-el.md): sunken removable
       wire-mesh bin. The floor drops through a chassis-plate opening so the
       ball is retained by real depth below the jump lip (20 mm) instead of
       the old 3 mm step. Collisions are solid boxes: a 66 mm ball cannot
       pass the <=40 mm mesh openings, so mesh vs solid is visual only.
       All *_ground params are in the GROUND frame; basket_link shares
       base_link's origin (base_link_height above ground). -->
  <xacro:macro name="ball_basket"
      params="parent floor_front_x floor_top_z_ground rear_x half_width wall_top_z_ground">
    <xacro:property name="floor_top" value="${floor_top_z_ground - base_link_height}"/>
    <xacro:property name="wall_top" value="${wall_top_z_ground - base_link_height}"/>
    <!-- Thin skinned bin: 5 mm floor (exterior bottom = floor_top - 0.005,
         the robot's lowest point), 10 mm wall frames. -->
    <xacro:property name="floor_thickness" value="0.005"/>
    <xacro:property name="wall_thickness" value="0.010"/>
    <xacro:property name="bin_length" value="${floor_front_x - rear_x}"/>
    <xacro:property name="wall_height" value="${wall_top - floor_top}"/>
    <xacro:property name="wall_centre_z" value="${(wall_top + floor_top) / 2.0}"/>
    <joint name="basket_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="basket_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="basket_link">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>

      <collision name="basket_floor_col">
        <origin xyz="${(floor_front_x + rear_x) / 2.0} 0 ${floor_top - floor_thickness / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${bin_length} ${2.0 * half_width} ${floor_thickness}"/></geometry>
      </collision>
      <visual name="basket_floor_vis">
        <origin xyz="${(floor_front_x + rear_x) / 2.0} 0 ${floor_top - floor_thickness / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${bin_length} ${2.0 * half_width} ${floor_thickness}"/></geometry>
        <material name="basket_gray"/>
      </visual>

      <!-- Side walls run the full bin length from floor to rim. -->
      <collision name="basket_left_wall_col">
        <origin xyz="${(floor_front_x + rear_x) / 2.0} ${half_width + wall_thickness / 2.0} ${wall_centre_z}" rpy="0 0 0"/>
        <geometry><box size="${bin_length} ${wall_thickness} ${wall_height}"/></geometry>
      </collision>
      <visual name="basket_left_wall_vis">
        <origin xyz="${(floor_front_x + rear_x) / 2.0} ${half_width + wall_thickness / 2.0} ${wall_centre_z}" rpy="0 0 0"/>
        <geometry><box size="${bin_length} ${wall_thickness} ${wall_height}"/></geometry>
        <material name="basket_gray"/>
      </visual>

      <collision name="basket_right_wall_col">
        <origin xyz="${(floor_front_x + rear_x) / 2.0} ${-(half_width + wall_thickness / 2.0)} ${wall_centre_z}" rpy="0 0 0"/>
        <geometry><box size="${bin_length} ${wall_thickness} ${wall_height}"/></geometry>
      </collision>
      <visual name="basket_right_wall_vis">
        <origin xyz="${(floor_front_x + rear_x) / 2.0} ${-(half_width + wall_thickness / 2.0)} ${wall_centre_z}" rpy="0 0 0"/>
        <geometry><box size="${bin_length} ${wall_thickness} ${wall_height}"/></geometry>
        <material name="basket_gray"/>
      </visual>

      <collision name="basket_rear_wall_col">
        <origin xyz="${rear_x - wall_thickness / 2.0} 0 ${wall_centre_z}" rpy="0 0 0"/>
        <geometry><box size="${wall_thickness} ${2.0 * (half_width + wall_thickness)} ${wall_height}"/></geometry>
      </collision>
      <visual name="basket_rear_wall_vis">
        <origin xyz="${rear_x - wall_thickness / 2.0} 0 ${wall_centre_z}" rpy="0 0 0"/>
        <geometry><box size="${wall_thickness} ${2.0 * (half_width + wall_thickness)} ${wall_height}"/></geometry>
        <material name="basket_gray"/>
      </visual>

      <!-- No front wall: the jump sheet's back face closes the front; the
           entry lip at (0.425, 0.045) is the only way in or out. -->

      <!-- IR beam pair line (sensors mount on the chassis and shine through
           the mesh — see spec §2). Height = rolling-ball equator. -->
      <visual name="basket_ir_beam_line_vis">
        <origin xyz="0.40 0 0.040" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.003" length="0.21"/></geometry>
        <material name="ir_beam_red"/>
      </visual>
    </link>
  </xacro:macro>
</robot>
