<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="oak_d_lite_mount" params="parent link_name xyz rpy update_rate">
    <link name="${link_name}">
      <inertial>
        <mass value="0.03"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
      <visual name="cam_vis">
        <geometry><box size="0.04 0.10 0.04"/></geometry>
        <material name="sensor_black"/>
      </visual>
      <visual name="rear_mount_plate_vis">
        <origin xyz="-0.055 0 -0.025" rpy="0 0 0"/>
        <geometry><box size="0.085 0.11 0.018"/></geometry>
        <material name="mount_gray"/>
      </visual>
      <visual name="lower_mount_stem_vis">
        <origin xyz="-0.075 0 -0.085" rpy="0 0 0"/>
        <geometry><box size="0.020 0.070 0.110"/></geometry>
        <material name="mount_gray"/>
      </visual>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${link_name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <!-- REP-103 optical frame: +X right, +Y down, +Z forward. -->
    <link name="${link_name}_optical_frame"/>
    <joint name="${link_name}_optical_joint" type="fixed">
      <parent link="${link_name}"/>
      <child link="${link_name}_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="${link_name}">
      <sensor name="front_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/gz/camera</topic>
        <gz_frame_id>${link_name}</gz_frame_id>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.08</near><far>18</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
        </camera>
      </sensor>

      <sensor name="front_depth" type="depth_camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <topic>/gz/depth</topic>
        <gz_frame_id>${link_name}</gz_frame_id>
        <camera>
          <horizontal_fov>1.274</horizontal_fov>
          <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
          <clip><near>0.20</near><far>12</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
