<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="oak_d_lite_mount" params="parent link_name xyz rpy update_rate">
    <link name="${link_name}">
      <!-- Mass unknown (S2 not purchased, not in the datasheet): placeholder. -->
      <inertial>
        <mass value="0.03"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
      <!-- OAK-D S2 enclosure 23.4 x 97.1 x 29.7 mm (official Luxonis STEP);
           camera_link = RGB lens on the front glass, lenses 19.67 mm above
           the enclosure bottom, so the box sits behind and slightly below the
           link and never enters the field of view. -->
      <visual name="cam_vis">
        <origin xyz="-0.0117 0 ${0.0297 / 2.0 - 0.01967}" rpy="0 0 0"/>
        <geometry><box size="0.0234 0.0971 0.0297"/></geometry>
        <material name="sensor_black"/>
      </visual>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${link_name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <!-- REP-103 optical frame: +X right, +Y down, +Z forward. -->
    <link name="${link_name}_optical_frame"/>
    <joint name="${link_name}_optical_joint" type="fixed">
      <parent link="${link_name}"/>
      <child link="${link_name}_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="${link_name}">
      <sensor name="front_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/gz/camera</topic>
        <gz_frame_id>${link_name}</gz_frame_id>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.08</near><far>18</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
        </camera>
      </sensor>

      <sensor name="front_depth" type="depth_camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <topic>/gz/depth</topic>
        <gz_frame_id>${link_name}</gz_frame_id>
        <camera>
          <!-- Must match the RGB intrinsics: perception fuses the same pixel
               ROI from timestamp-matched RGB/depth frames.  Different FOVs
               make that ROI sample a different world ray (usually court
               background behind a small ball), producing a false long range. -->
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
          <clip><near>0.20</near><far>12</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
