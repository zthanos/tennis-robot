<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
          ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
          iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
          izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length axis">
    <inertial>
      <mass value="${mass}"/>
      <xacro:if value="${axis == 'y'}">
        <inertia
            ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}" ixy="0" ixz="0"
            iyy="${0.5 * mass * radius * radius}" iyz="0"
            izz="${mass * (3.0 * radius * radius + length * length) / 12.0}"/>
      </xacro:if>
      <xacro:unless value="${axis == 'y'}">
        <inertia
            ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}" ixy="0" ixz="0"
            iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}" iyz="0"
            izz="${0.5 * mass * radius * radius}"/>
      </xacro:unless>
    </inertial>
  </xacro:macro>

  <!-- P2-99c (c): modular v3 PETG chassis (cad/modular-test-chassis/
       modular-chassis-v3.scad), as transcribed for the isolated v3 bench
       (engineering/shared-flywheel-isolated-bench/v3_chassis_flywheel_bench.urdf.xacro):
       50x30 rails at Y+-220 from X-165 to X330, crossbars at X-165 / X240 /
       X300. Geometry is CAD mm (ground frame) and passes through D1.

       Mass: the v3 bench whole-robot model lumps 10.0 kg at CAD
       (100, 0, 120) mm for frame + drivetrain + arch + shell + electronics.
       Drive wheels, drive motors and the C1 are separate links here, so
       base_link carries the remainder (lump_mass - separate_mass) at the
       position that keeps the lump's centre of mass. NO weighed values exist
       (ΤΕΚΜΗΡΙΩΣΗ ΛΕΙΠΕΙ): this is the CAD estimate until the robot is weighed. -->
  <xacro:macro name="v3_rail_box" params="name cx cy cz sx sy sz">
    <collision name="${name}_col">
      <origin xyz="${cx * 0.001 + cad_to_base_x} ${cy * 0.001} ${cz * 0.001 + cad_to_base_z}" rpy="0 0 0"/>
      <geometry><box size="${sx * 0.001} ${sy * 0.001} ${sz * 0.001}"/></geometry>
    </collision>
    <visual name="${name}_vis">
      <origin xyz="${cx * 0.001 + cad_to_base_x} ${cy * 0.001} ${cz * 0.001 + cad_to_base_z}" rpy="0 0 0"/>
      <geometry><box size="${sx * 0.001} ${sy * 0.001} ${sz * 0.001}"/></geometry>
      <material name="frame_blue_v3"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="tennis_robot_base"
               params="base_link_height cad_to_base_x cad_to_base_z base_mass base_com_x_mm base_com_y_mm base_com_z_mm entry_beam_x entry_beam_z entry_beam_width">
    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <!-- base_footprint is the ground plane; base_link is the axle midpoint
           (CAD X117.5) 45 mm above ground (P2-99c D1). -->
      <origin xyz="0 0 ${base_link_height}" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
      <inertial>
        <origin xyz="${base_com_x_mm * 0.001 + cad_to_base_x} ${base_com_y_mm * 0.001} ${base_com_z_mm * 0.001 + cad_to_base_z}" rpy="0 0 0"/>
        <mass value="${base_mass}"/>
        <!-- v3 bench lump inertia (0.62/0.45/0.86, ixz -0.05 kg m^2 for
             10 kg) scaled by base_mass / 10. -->
        <inertia ixx="${0.062 * base_mass}" ixy="0" ixz="${-0.005 * base_mass}"
                 iyy="${0.045 * base_mass}" iyz="0" izz="${0.086 * base_mass}"/>
      </inertial>
      <xacro:v3_rail_box name="left_rail" cx="82.5" cy="220" cz="37" sx="495" sy="50" sz="30"/>
      <xacro:v3_rail_box name="right_rail" cx="82.5" cy="-220" cz="37" sx="495" sy="50" sz="30"/>
      <xacro:v3_rail_box name="rear_crossbar" cx="-165" cy="0" cz="37" sx="50" sy="390" sz="30"/>
      <xacro:v3_rail_box name="x240_crossbar" cx="240" cy="0" cz="32" sx="50" sy="390" sz="20"/>
      <xacro:v3_rail_box name="x300_crossbar" cx="300" cy="0" cz="32" sx="20" sy="390" sz="20"/>
      <!-- Entry beam-line visual. Its position and width are injected from the
           same properties that place the two Gazebo rays, so diagnostics can
           never drift away from the actual sensing geometry. -->
      <visual name="ir_beam_line_vis">
        <origin xyz="${entry_beam_x} 0 ${entry_beam_z}" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.003" length="${entry_beam_width}"/></geometry>
        <material name="ir_beam_red"/>
      </visual>
    </link>

    <gazebo reference="base_link">
      <material>Gazebo/Wood</material>
    </gazebo>
  </xacro:macro>
</robot>
