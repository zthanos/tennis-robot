<?xml version="1.0" encoding="UTF-8"?>
<!--
  ros2_control hardware description for the tennis robot.

  This is the single contract between the high-level stack and the actuators.
  Swapping the <hardware> plugin (sim_mode arg) is the ONLY change required to
  move from Gazebo to the real robot: controllers, command topics and the whole
  behavior stack above stay identical.

  Joints exposed (4WD skid-steer):
    rear_left_wheel_joint  / front_left_wheel_joint  -> velocity command (left side)
    rear_right_wheel_joint / front_right_wheel_joint -> velocity command (right side)
    intake_wheel_left_joint / intake_wheel_right_joint -> velocity command
      (dual-wheel side-pinch intake; one GB37Y3530-12V-251R motor per wheel,
       commanded with opposite signs so both inner faces drive rearward)
    intake_assist_wheel_joint -> optional second-stage ramp assist roller
    intake_conveyor_*_joint -> optional Phase 3B ramp conveyor approximation
	  flywheel_left_joint / flywheel_right_joint -> optional launcher wheels
	-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- intake_max_vel = GB37Y3530-12V-251R no-load speed (251 RPM = 26.3 rad/s). -->
  <xacro:macro name="tennis_robot_ros2_control"
               params="sim_mode:=true controllers_config wheel_max_vel:=20.0 intake_max_vel:=26.3 flywheel_max_vel:=320.0 expose_intake_carriage_state:=false enable_flywheel:=false enable_assist:=false enable_conveyor:=false">

    <ros2_control name="TennisRobotSystem" type="system">

      <!-- Hardware backend (the only sim/real difference) -->
      <xacro:if value="${sim_mode}">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
      </xacro:if>
      <xacro:unless value="${sim_mode}">
        <hardware>
          <!-- TODO(real-robot): replace with the motor-driver hardware interface,
               e.g. a custom tennis_robot_hardware/DiffDriveHardware plugin that
               talks to the BTS7960 drivers over serial/PWM. Same joint names.
               Real wiring: the two motors on each side are wired in PARALLEL to a
               single BTS7960 driver, with ONE encoder per side. So the front/rear
               joints on a side share one velocity command and one feedback source
               (front mirrors rear). Map both side joints to the same side channel. -->
          <plugin>tennis_robot_hardware/TennisRobotSystem</plugin>
          <param name="left_wheel_names">rear_left_wheel_joint,front_left_wheel_joint</param>
          <param name="right_wheel_names">rear_right_wheel_joint,front_right_wheel_joint</param>
          <!-- Two identical GB37 motors, one driver channel each. -->
          <param name="intake_wheel_names">intake_wheel_left_joint,intake_wheel_right_joint</param>
          <xacro:if value="${enable_flywheel}">
            <param name="flywheel_names">flywheel_left_joint,flywheel_right_joint</param>
          </xacro:if>
          <xacro:if value="${enable_assist}">
            <param name="assist_wheel_names">intake_assist_wheel_joint</param>
          </xacro:if>
          <xacro:if value="${enable_conveyor}">
            <param name="conveyor_wheel_names">intake_conveyor_front_joint,intake_conveyor_mid_joint,intake_conveyor_rear_joint</param>
          </xacro:if>
        </hardware>
      </xacro:unless>

      <!-- Drive joints (4WD skid-steer: 2 per side) -->
      <joint name="rear_left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-${wheel_max_vel}</param>
          <param name="max">${wheel_max_vel}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="front_left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-${wheel_max_vel}</param>
          <param name="max">${wheel_max_vel}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="rear_right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-${wheel_max_vel}</param>
          <param name="max">${wheel_max_vel}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="front_right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-${wheel_max_vel}</param>
          <param name="max">${wheel_max_vel}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Dual-wheel intake (one motor per wheel, opposite spin) -->
      <joint name="intake_wheel_left_joint">
        <command_interface name="velocity">
          <param name="min">-${intake_max_vel}</param>
          <param name="max">${intake_max_vel}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="intake_wheel_right_joint">
        <command_interface name="velocity">
          <param name="min">-${intake_max_vel}</param>
          <param name="max">${intake_max_vel}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Optional two-motor side-by-side launcher. Opposite commands make
           both inner wheel faces drive the ball forward (+X). -->
      <xacro:if value="${enable_flywheel}">
        <joint name="flywheel_left_joint">
          <command_interface name="velocity">
            <param name="min">-${flywheel_max_vel}</param>
            <param name="max">${flywheel_max_vel}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="flywheel_right_joint">
          <command_interface name="velocity">
            <param name="min">-${flywheel_max_vel}</param>
            <param name="max">${flywheel_max_vel}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:if>

      <!-- Gazebo-only observability for the passive spring carriages. The
           physical prototype has no carriage encoder, so these state-only
           interfaces must not become part of the real hardware contract. -->
      <xacro:if value="${sim_mode}">
        <xacro:if value="${expose_intake_carriage_state}">
          <joint name="intake_wheel_left_carriage_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </joint>
          <joint name="intake_wheel_right_carriage_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </joint>
        </xacro:if>
      </xacro:if>

      <!-- Optional Phase 3 second-stage assist roller. -->
      <xacro:if value="${enable_assist}">
        <joint name="intake_assist_wheel_joint">
          <command_interface name="velocity">
            <param name="min">-${intake_max_vel}</param>
            <param name="max">${intake_max_vel}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:if>

      <!-- Optional Phase 3B ramp conveyor approximation. -->
      <xacro:if value="${enable_conveyor}">
        <joint name="intake_conveyor_front_joint">
          <command_interface name="velocity">
            <param name="min">-${intake_max_vel}</param>
            <param name="max">${intake_max_vel}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="intake_conveyor_mid_joint">
          <command_interface name="velocity">
            <param name="min">-${intake_max_vel}</param>
            <param name="max">${intake_max_vel}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="intake_conveyor_rear_joint">
          <command_interface name="velocity">
            <param name="min">-${intake_max_vel}</param>
            <param name="max">${intake_max_vel}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:if>

    </ros2_control>

    <!-- gz_ros2_control system plugin (sim only) -->
    <xacro:if value="${sim_mode}">
      <gazebo>
        <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${controllers_config}</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
