<?xml version="1.0" encoding="UTF-8"?>
<!--
  ros2_control hardware description for the tennis robot.

  This is the single contract between the high-level stack and the actuators.
  Swapping the <hardware> plugin (sim_mode arg) is the ONLY change required to
  move from Gazebo to the real robot: controllers, command topics and the whole
  behavior stack above stay identical.

  Joints exposed (4WD skid-steer):
    rear_left_wheel_joint  / front_left_wheel_joint  -> velocity command (left side)
    rear_right_wheel_joint / front_right_wheel_joint -> velocity command (right side)
    lift_wheel_joint                                 -> velocity command (intake roller)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="tennis_robot_ros2_control"
               params="sim_mode:=true controllers_config wheel_max_vel:=20.0 lift_max_vel:=40.0">

    <ros2_control name="TennisRobotSystem" type="system">

      <!-- Hardware backend (the only sim/real difference) -->
      <xacro:if value="${sim_mode}">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
      </xacro:if>
      <xacro:unless value="${sim_mode}">
        <hardware>
          <!-- TODO(real-robot): replace with the motor-driver hardware interface,
               e.g. a custom tennis_robot_hardware/DiffDriveHardware plugin that
               talks to the BTS7960 drivers over serial/PWM. Same joint names.
               Real wiring: the two motors on each side are wired in PARALLEL to a
               single BTS7960 driver, with ONE encoder per side. So the front/rear
               joints on a side share one velocity command and one feedback source
               (front mirrors rear). Map both side joints to the same side channel. -->
          <plugin>tennis_robot_hardware/TennisRobotSystem</plugin>
          <param name="left_wheel_names">rear_left_wheel_joint,front_left_wheel_joint</param>
          <param name="right_wheel_names">rear_right_wheel_joint,front_right_wheel_joint</param>
          <param name="lift_wheel_name">lift_wheel_joint</param>
        </hardware>
      </xacro:unless>

      <!-- Drive joints (4WD skid-steer: 2 per side) -->
      <joint name="rear_left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-${wheel_max_vel}</param>
          <param name="max">${wheel_max_vel}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="front_left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-${wheel_max_vel}</param>
          <param name="max">${wheel_max_vel}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="rear_right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-${wheel_max_vel}</param>
          <param name="max">${wheel_max_vel}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="front_right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-${wheel_max_vel}</param>
          <param name="max">${wheel_max_vel}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Intake roller -->
      <joint name="lift_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-${lift_max_vel}</param>
          <param name="max">${lift_max_vel}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>

    <!-- gz_ros2_control system plugin (sim only) -->
    <xacro:if value="${sim_mode}">
      <gazebo>
        <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${controllers_config}</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
