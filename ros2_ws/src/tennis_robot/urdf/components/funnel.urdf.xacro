<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="intake_funnel" params="parent chassis_z">
    <joint name="funnel_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="funnel_link"/>
      <origin xyz="0 0 ${-chassis_z / 2}" rpy="0 0 0"/>
    </joint>
    <link name="funnel_link">
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>

      <visual name="funnel_left_cheek_vis">
        <origin xyz="0.54 0.14 0.08" rpy="0 0 0.25"/>
        <geometry><box size="0.18 0.01 0.14"/></geometry>
        <material name="intake_orange"/>
      </visual>

      <visual name="funnel_right_cheek_vis">
        <origin xyz="0.54 -0.14 0.08" rpy="0 0 -0.25"/>
        <geometry><box size="0.18 0.01 0.14"/></geometry>
        <material name="intake_orange"/>
      </visual>

      <collision name="roller_exit_floor_col">
        <origin xyz="0.54 0 0.01" rpy="0 0 0"/>
        <geometry><box size="0.16 0.24 0.005"/></geometry>
      </collision>
      <visual name="roller_exit_floor_vis">
        <origin xyz="0.54 0 0.01" rpy="0 0 0"/>
        <geometry><box size="0.16 0.24 0.005"/></geometry>
        <material name="intake_orange"/>
      </visual>

      <visual name="internal_slide_vis">
        <origin xyz="0.40 0 0.03" rpy="0 -0.12 0"/>
        <geometry><box size="0.14 0.24 0.005"/></geometry>
        <material name="intake_orange"/>
      </visual>
    </link>
  </xacro:macro>
</robot>