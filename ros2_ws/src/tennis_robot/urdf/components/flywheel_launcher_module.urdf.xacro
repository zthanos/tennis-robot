<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Standalone reconstruction of cad/flywheel-launcher-v0/launcher-envelope.scad.

    Launcher-local frame:
      origin  = ball centre at the geometric nip
      +X      = launch direction
      +Y      = left
      +Z      = upper cradle plate / positive wheel axis before mounting pitch

    The dimensions below are intentionally literal mirrors of params.scad so
    tests can prove equality. This macro is not the compact-robot integration
    model and contains no feeder, basket or intake geometry.
  -->
  <xacro:macro name="authoritative_flywheel_launcher_module"
      params="parent origin_xyz:='0 0 0' pitch_rad:='0.349065850399'
              wheel_mass:=0.40 fixed_mass:=4.4525888
              max_vel:=320.0 effort:=6.0">
    <xacro:property name="launcher_ball_d" value="0.066"/>
    <xacro:property name="launcher_wheel_radius" value="0.100"/>
    <xacro:property name="launcher_wheel_width" value="0.050"/>
    <xacro:property name="launcher_nip_gap" value="0.058"/>
    <xacro:property name="launcher_wheel_center_distance" value="0.258"/>
    <xacro:property name="launcher_wheel_y" value="0.129"/>
    <xacro:property name="launcher_plate_x" value="0.256"/>
    <xacro:property name="launcher_plate_y" value="0.314"/>
    <xacro:property name="launcher_plate_z" value="0.008"/>
    <xacro:property name="launcher_plate_offset_z" value="0.043"/>

    <joint name="flywheel_launcher_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="flywheel_launcher_frame_link"/>
      <origin xyz="${origin_xyz}" rpy="0 ${-float(pitch_rad)} 0"/>
    </joint>
    <gazebo reference="flywheel_launcher_mount_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="flywheel_launcher_frame_link">
      <!--
        fixed_mass is a declared simulation estimate, not an authoritative CAD
        mass: two 256x314x8 mm aluminium plates at 2700 kg/m^3 (3.4725888 kg)
        plus two documented 0.49 kg D5065 motors. Symmetry places the estimate
        at the nip origin. The inertia is a conservative box-envelope estimate
        pending manufactured-part mass properties.
      -->
      <inertial>
        <mass value="${fixed_mass}"/>
        <inertia ixx="${fixed_mass * (launcher_plate_y*launcher_plate_y + 0.094*0.094) / 12.0}"
                 ixy="0" ixz="0"
                 iyy="${fixed_mass * (launcher_plate_x*launcher_plate_x + 0.094*0.094) / 12.0}"
                 iyz="0"
                 izz="${fixed_mass * (launcher_plate_x*launcher_plate_x + launcher_plate_y*launcher_plate_y) / 12.0}"/>
      </inertial>
      <collision name="flywheel_cradle_lower_plate_col">
        <origin xyz="0 0 ${-launcher_plate_offset_z}" rpy="0 0 0"/>
        <geometry><box size="${launcher_plate_x} ${launcher_plate_y} ${launcher_plate_z}"/></geometry>
      </collision>
      <visual name="flywheel_cradle_lower_plate_vis">
        <origin xyz="0 0 ${-launcher_plate_offset_z}" rpy="0 0 0"/>
        <geometry><box size="${launcher_plate_x} ${launcher_plate_y} ${launcher_plate_z}"/></geometry>
        <material name="mount_gray"/>
      </visual>
      <collision name="flywheel_cradle_upper_plate_col">
        <origin xyz="0 0 ${launcher_plate_offset_z}" rpy="0 0 0"/>
        <geometry><box size="${launcher_plate_x} ${launcher_plate_y} ${launcher_plate_z}"/></geometry>
      </collision>
      <visual name="flywheel_cradle_upper_plate_vis">
        <origin xyz="0 0 ${launcher_plate_offset_z}" rpy="0 0 0"/>
        <geometry><box size="${launcher_plate_x} ${launcher_plate_y} ${launcher_plate_z}"/></geometry>
        <material name="mount_gray"/>
      </visual>
    </link>

    <xacro:flywheel_wheel side="left" parent="flywheel_launcher_frame_link"
        y="${launcher_wheel_y}" radius="${launcher_wheel_radius}"
        width="${launcher_wheel_width}" mass="${wheel_mass}"
        max_vel="${max_vel}" effort="${effort}"/>
    <xacro:flywheel_wheel side="right" parent="flywheel_launcher_frame_link"
        y="${-launcher_wheel_y}" radius="${launcher_wheel_radius}"
        width="${launcher_wheel_width}" mass="${wheel_mass}"
        max_vel="${max_vel}" effort="${effort}"/>
  </xacro:macro>
</robot>
