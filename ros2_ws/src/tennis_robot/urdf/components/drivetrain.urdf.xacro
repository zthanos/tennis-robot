<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="drive_motor" params="side y motor_x shaft_z radius length mass">
    <link name="${side}_motor_link">
      <xacro:cylinder_inertial mass="${mass}" radius="${radius}" length="${length}" axis="y"/>
      <collision name="motor_col">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
      <visual name="motor_vis">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="mount_gray"/>
      </visual>
    </link>
    <joint name="${side}_motor_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_motor_link"/>
      <origin xyz="${motor_x} ${y} ${shaft_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="drive_wheel" params="side y wheel_x wheel_z radius width mass">
    <link name="${side}_wheel_link">
      <xacro:cylinder_inertial mass="${mass}" radius="${radius}" length="${width}" axis="y"/>
      <collision name="col">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
      </collision>
      <visual name="vis">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
        <material name="rubber_black"/>
      </visual>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.001"/>
    </joint>
    <gazebo reference="${side}_wheel_link">
      <!-- Moderate friction on all four driven wheels. 4WD skid-steer turning
           relies on lateral slip; the previous mu=5.0 over-resisted rotation,
           making in-place turns crawl and survey waypoints time out. mu=1.2
           keeps enough forward grip (court surface adds more) while letting the
           robot rotate quickly. -->
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <slip1>0.0</slip1>
      <slip2>0.0</slip2>
    </gazebo>
  </xacro:macro>

  <!-- Casters removed: the robot is now 4WD skid-steer (four driven wheels via
       the drive_wheel macro above). The old swivel-caster macro and its scrub
       resistance are gone. -->

  <!-- FIXED-MOTOR, COMPLIANT-TYRE INTAKE (frozen CAD architecture).
       Sources: cad/standalone-intake-fixed-motor/
       standalone-intake-fixed-motor-compliant-tyre.scad (wheel/motor/bridge)
       and cad/collector-intake-v1/option-a/option-a.scad (layout).
       Both FIT0186 motors and both Raid wheel centres are FIXED to the
       plywood bridge.  Each side is ONE rigid coaxial assembly: a fixed mount
       link carrying the adapter + motor envelope, and the wheel spinning on
       the single 35 degree axis.  There is no carriage, no prismatic DOF, no
       return spring and no SDF spring patch: the legacy
       SIMULATION_ONLY_TYRE_COMPLIANCE_SURROGATE was removed outright rather
       than zeroed, so it cannot be re-enabled by a parameter.
       Compliance belongs to the tennis ball and the Trencher tyre/foam and is
       NOT represented by a joint; tyre radial deflection, wheel droop, torque
       and current are owned by the reduced-order solver
       (scripts/run_standalone_intake_handoff_study.py), not by Gazebo.

       Wheel axes are parallel and lie in the longitudinal X-Z plane; only the
       wheel centres are mirrored in Y.  Both inner faces drive rearward (-x).

       tread_mu is a SWEPT bound, injected per run by
       scripts/generate_robot_urdf.py from INTAKE_TREAD_MU over the same
       0.3 / 0.6 / 0.9 range as the reduced-order study.  Felt/tread friction
       is physically unmeasured; no single value may be selected to make a
       result pass. -->
  <xacro:macro name="intake_side_wheel"
               params="side y nip_x wheel_z tilt_rad radius height max_vel effort mass sensor_index tread_mu:=0.6 parent:=base_link">
    <link name="intake_wheel_${side}_mount_link">
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
      <!-- Coaxial purchased direct-drive hardware. Local +Z is wheel->motor;
           common pitch maps both sides to (sin(tilt), 0, cos(tilt)). -->
      <collision name="intake_adapter_col">
        <origin xyz="${sin(tilt_rad) * 0.0435} 0 ${cos(tilt_rad) * 0.0435}"
                rpy="0 ${tilt_rad} 0"/>
        <geometry><cylinder radius="0.010" length="0.030"/></geometry>
      </collision>
      <visual name="intake_adapter_vis">
        <origin xyz="${sin(tilt_rad) * 0.0435} 0 ${cos(tilt_rad) * 0.0435}"
                rpy="0 ${tilt_rad} 0"/>
        <geometry><cylinder radius="0.010" length="0.030"/></geometry>
        <material name="safety_orange"/>
      </visual>
      <collision name="intake_motor_col">
        <origin xyz="${sin(tilt_rad) * 0.0935} 0 ${cos(tilt_rad) * 0.0935}"
                rpy="0 ${tilt_rad} 0"/>
        <geometry><cylinder radius="0.015" length="0.070"/></geometry>
      </collision>
      <visual name="intake_motor_vis">
        <origin xyz="${sin(tilt_rad) * 0.0935} 0 ${cos(tilt_rad) * 0.0935}"
                rpy="0 ${tilt_rad} 0"/>
        <geometry><cylinder radius="0.015" length="0.070"/></geometry>
        <material name="mount_gray"/>
      </visual>
    </link>
    <!-- Rigid weld to the bridge. The physical load path is the printed
         D30 x 10 mm motor collar plus its bridge pad. -->
    <joint name="intake_wheel_${side}_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="intake_wheel_${side}_mount_link"/>
      <origin xyz="${nip_x} ${y} ${wheel_z}" rpy="0 0 0"/>
    </joint>
    <link name="intake_wheel_${side}_link">
      <xacro:cylinder_inertial mass="${mass}" radius="${radius}" length="${height}" axis="z"/>
      <collision name="wheel_col">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="${radius}" length="${height}"/></geometry>
      </collision>
      <visual name="wheel_vis">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="${radius}" length="${height}"/></geometry>
        <material name="rubber_black"/>
      </visual>
      <visual name="wheel_spin_marker_vis">
        <origin xyz="${radius - 0.004} 0 ${height / 2 - 0.008}" rpy="0 0 0"/>
        <geometry><box size="0.006 0.02 0.012"/></geometry>
        <material name="safety_orange"/>
      </visual>
    </link>
    <!-- GB37Y3530-12V-251R per wheel: no-load 26.3 rad/s, stall 1.77 N.m.
         DECLARED LIMITATION (D4): gz_ros2_control velocity commands act as an
         IDEAL VELOCITY SOURCE — the effort limit is not a physical stall
         model. Wheel droop, motor torque and motor current are therefore NOT
         MEASURABLE IN GAZEBO and must not be reported from it; they come from
         the bounded FIT0186 law in the reduced-order solver. Jam is detected
         from ball motion + contact, never from wheel droop. -->
    <joint name="intake_wheel_${side}_joint" type="continuous">
      <parent link="intake_wheel_${side}_mount_link"/>
      <child link="intake_wheel_${side}_link"/>
      <origin xyz="0 0 0" rpy="0 ${tilt_rad} 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="${effort}" velocity="${max_vel}"/>
      <dynamics damping="0.005"/>
    </joint>
    <gazebo reference="intake_wheel_${side}_link">
      <mu1>${tread_mu}</mu1>
      <mu2>${tread_mu}</mu2>
      <!-- 500 Hz: throat transit is impulsive (~tens of ms; the first live
           run at 100 Hz sampled ZERO messages while the ball measurably
           passed through at 0.77 m/s) — sample near the physics rate so
           both-wheel contact confirmation cannot be missed. -->
      <sensor name="roller_contact_${sensor_index}" type="contact">
        <always_on>true</always_on><update_rate>500</update_rate>
        <topic>/gz/roller_contact_${sensor_index}</topic>
        <contact><collision>wheel_col</collision></contact>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Phase 3B conveyor approximation: several small powered rollers along
       the ramp create active contact over length, without modelling a
       deformable belt in Gazebo. Axis is y; positive joint velocity makes the
       lower surface move rearward (-x). -->
  <xacro:macro name="intake_ramp_conveyor_roller"
               params="name parent x z radius length mass tread_mu:=0.6">
    <link name="${name}_link">
      <xacro:cylinder_inertial mass="${mass}" radius="${radius}" length="${length}" axis="y"/>
      <collision name="${name}_col">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
      <visual name="${name}_vis">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="rubber_black"/>
      </visual>
      <visual name="${name}_marker_vis">
        <origin xyz="0 ${length / 2 - 0.012} ${-radius + 0.004}" rpy="0 0 0"/>
        <geometry><box size="0.018 0.006 0.006"/></geometry>
        <material name="safety_orange"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${x} 0 ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="1.77" velocity="26.3"/>
      <dynamics damping="0.005"/>
    </joint>
    <gazebo reference="${name}_link">
      <!-- Swept bound, same range as the reduced-order study (D3). -->
      <mu1>${tread_mu}</mu1>
      <mu2>${tread_mu}</mu2>
    </gazebo>
  </xacro:macro>

  <!-- Active second-stage assist roller for Phase 3 experiments. Axis is y;
       positive joint velocity makes the bottom surface move rearward (-x),
       helping the ball continue from the dual-wheel throat onto the ramp.
       This is opt-in via enable_assist so Phases 1-2 and passive ramp tests
       stay comparable. -->
  <xacro:macro name="intake_assist_roller"
               params="parent x z radius length mass tread_mu:=0.6">
    <link name="intake_assist_wheel_link">
      <xacro:cylinder_inertial mass="${mass}" radius="${radius}" length="${length}" axis="y"/>
      <collision name="assist_wheel_col">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
      <visual name="assist_wheel_vis">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="rubber_black"/>
      </visual>
      <visual name="assist_spin_marker_vis">
        <origin xyz="0 ${length / 2 - 0.012} ${-radius + 0.004}" rpy="0 0 0"/>
        <geometry><box size="0.018 0.006 0.006"/></geometry>
        <material name="safety_orange"/>
      </visual>
    </link>
    <joint name="intake_assist_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="intake_assist_wheel_link"/>
      <origin xyz="${x} 0 ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="1.77" velocity="26.3"/>
      <dynamics damping="0.005"/>
    </joint>
    <gazebo reference="intake_assist_wheel_link">
      <!-- Swept bound, same range as the reduced-order study (D3). -->
      <mu1>${tread_mu}</mu1>
      <mu2>${tread_mu}</mu2>
    </gazebo>
  </xacro:macro>

  <!--
    NOTE: The legacy Gazebo control plugins (gz-sim-diff-drive-system,
    gz-sim-joint-state-publisher-system, gz-sim-joint-controller-system) were
    removed during the ros2_control migration. Wheel + intake actuation is now
    owned by ros2_control via components/ros2_control.urdf.xacro. Odometry,
    /tf and /joint_states are published by diff_drive_controller +
    joint_state_broadcaster instead of these plugins.
  -->
</robot>
