<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="drive_motor" params="side y motor_x shaft_z radius length mass">
    <link name="${side}_motor_link">
      <xacro:cylinder_inertial mass="${mass}" radius="${radius}" length="${length}" axis="y"/>
      <collision name="motor_col">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
      <visual name="motor_vis">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="mount_gray"/>
      </visual>
    </link>
    <joint name="${side}_motor_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_motor_link"/>
      <origin xyz="${motor_x} ${y} ${shaft_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="drive_wheel" params="side y wheel_x wheel_z radius width mass">
    <link name="${side}_wheel_link">
      <xacro:cylinder_inertial mass="${mass}" radius="${radius}" length="${width}" axis="y"/>
      <collision name="col">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
      </collision>
      <visual name="vis">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
        <material name="rubber_black"/>
      </visual>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.001"/>
    </joint>
    <gazebo reference="${side}_wheel_link">
      <!-- Moderate friction on all four driven wheels. 4WD skid-steer turning
           relies on lateral slip; the previous mu=5.0 over-resisted rotation,
           making in-place turns crawl and survey waypoints time out. mu=1.2
           keeps enough forward grip (court surface adds more) while letting the
           robot rotate quickly. -->
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <slip1>0.0</slip1>
      <slip2>0.0</slip2>
    </gazebo>
  </xacro:macro>

  <!-- Casters removed: the robot is now 4WD skid-steer (four driven wheels via
       the drive_wheel macro above). The old swivel-caster macro and its scrub
       resistance are gone. -->

  <!-- One paddle belonging to the single intake-roller link. `angle` is in the
       link's x-z plane; rotating the link rotates core and all paddles together. -->
  <xacro:macro name="intake_flap" params="name angle radius width">
    <collision name="${name}_col">
      <origin
          xyz="${radius * 0.72 * cos(angle)} 0 ${radius * 0.72 * sin(angle)}"
          rpy="0 ${-angle} 0"/>
      <geometry><box size="${radius * 0.56} ${width} 0.004"/></geometry>
    </collision>
    <visual name="${name}_vis">
      <origin
          xyz="${radius * 0.72 * cos(angle)} 0 ${radius * 0.72 * sin(angle)}"
          rpy="0 ${-angle} 0"/>
      <geometry><box size="${radius * 0.56} ${width} 0.004"/></geometry>
      <material name="rubber_black"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="intake_roller" params="x z radius width mass">
    <link name="lift_wheel_link">
      <xacro:cylinder_inertial mass="${mass}" radius="${radius}" length="${width}" axis="y"/>
      <!-- Small rigid hub; the paddles sweep the full `radius` envelope
           (Ø90 mm with the current intake_radius=0.045). Roller-first design:
           this envelope is the first hard contact with the ball. -->
      <collision name="core_col">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius * 0.44}" length="${width}"/></geometry>
      </collision>
      <visual name="core_vis">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius * 0.44}" length="${width}"/></geometry>
        <material name="rubber_black"/>
      </visual>
      <xacro:intake_flap name="flap_0" angle="0.0" radius="${radius}" width="${width}"/>
      <xacro:intake_flap name="flap_1" angle="${pi / 4.0}" radius="${radius}" width="${width}"/>
      <xacro:intake_flap name="flap_2" angle="${pi / 2.0}" radius="${radius}" width="${width}"/>
      <xacro:intake_flap name="flap_3" angle="${3.0 * pi / 4.0}" radius="${radius}" width="${width}"/>
      <xacro:intake_flap name="flap_4" angle="${pi}" radius="${radius}" width="${width}"/>
      <xacro:intake_flap name="flap_5" angle="${5.0 * pi / 4.0}" radius="${radius}" width="${width}"/>
      <xacro:intake_flap name="flap_6" angle="${3.0 * pi / 2.0}" radius="${radius}" width="${width}"/>
      <xacro:intake_flap name="flap_7" angle="${7.0 * pi / 4.0}" radius="${radius}" width="${width}"/>
    </link>
    <joint name="lift_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="lift_wheel_link"/>
      <origin xyz="${x} 0 ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="lift_wheel_link">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <!-- One contact sensor per paddle. Gazebo publishes the real physics
           contact positions; gazebo_extras_node turns them into short-lived
           red RViz markers and a /sim/roller_contact heartbeat. -->
      <sensor name="roller_contact_0" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <topic>/gz/roller_contact_0</topic>
        <contact><collision>flap_0_col</collision></contact>
      </sensor>
      <sensor name="roller_contact_1" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <topic>/gz/roller_contact_1</topic>
        <contact><collision>flap_1_col</collision></contact>
      </sensor>
      <sensor name="roller_contact_2" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <topic>/gz/roller_contact_2</topic>
        <contact><collision>flap_2_col</collision></contact>
      </sensor>
      <sensor name="roller_contact_3" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <topic>/gz/roller_contact_3</topic>
        <contact><collision>flap_3_col</collision></contact>
      </sensor>
      <sensor name="roller_contact_4" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <topic>/gz/roller_contact_4</topic>
        <contact><collision>flap_4_col</collision></contact>
      </sensor>
      <sensor name="roller_contact_5" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <topic>/gz/roller_contact_5</topic>
        <contact><collision>flap_5_col</collision></contact>
      </sensor>
      <sensor name="roller_contact_6" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <topic>/gz/roller_contact_6</topic>
        <contact><collision>flap_6_col</collision></contact>
      </sensor>
      <sensor name="roller_contact_7" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <topic>/gz/roller_contact_7</topic>
        <contact><collision>flap_7_col</collision></contact>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!--
    NOTE: The legacy Gazebo control plugins (gz-sim-diff-drive-system,
    gz-sim-joint-state-publisher-system, gz-sim-joint-controller-system) were
    removed during the ros2_control migration. Wheel + intake actuation is now
    owned by ros2_control via components/ros2_control.urdf.xacro. Odometry,
    /tf and /joint_states are published by diff_drive_controller +
    joint_state_broadcaster instead of these plugins.
  -->
</robot>
