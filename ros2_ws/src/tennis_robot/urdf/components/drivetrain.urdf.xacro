<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="drive_wheel" params="side y wheel_x wheel_z radius width mass">
    <link name="${side}_wheel_link">
      <xacro:cylinder_inertial mass="${mass}" radius="${radius}" length="${width}" axis="y"/>
      <collision name="col">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
      </collision>
      <visual name="vis">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
        <material name="rubber_black"/>
      </visual>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.001"/>
    </joint>
    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>0.5</mu2>
      <fdir1>1 0 0</fdir1>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="caster" params="name x y z radius">
    <link name="${name}_caster_swivel_link">
      <inertial>
        <mass value="0.03"/>
        <inertia ixx="5e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="5e-5"/>
      </inertial>
      <visual name="swivel_stem_vis">
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <geometry><cylinder radius="0.014" length="0.09"/></geometry>
        <material name="mount_gray"/>
      </visual>
      <visual name="caster_fork_vis">
        <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        <geometry><box size="0.075 0.020 0.055"/></geometry>
        <material name="mount_gray"/>
      </visual>
    </link>
    <joint name="${name}_caster_swivel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_caster_swivel_link"/>
      <origin xyz="${x} ${y} ${z + radius}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.02" friction="0.001"/>
    </joint>

    <link name="${name}_caster_wheel_link">
      <xacro:cylinder_inertial mass="0.05" radius="${radius}" length="0.030" axis="y"/>
      <collision name="col">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="0.030"/></geometry>
      </collision>
      <visual name="vis">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="0.030"/></geometry>
        <material name="rubber_black"/>
      </visual>
    </link>
    <joint name="${name}_caster_wheel_joint" type="continuous">
      <parent link="${name}_caster_swivel_link"/>
      <child link="${name}_caster_wheel_link"/>
      <origin xyz="0 0 -${radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.001" friction="0.0"/>
    </joint>

    <gazebo reference="${name}_caster_wheel_link">
      <mu1>0.8</mu1>
      <mu2>0.05</mu2>
      <fdir1>1 0 0</fdir1>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="intake_roller" params="x z radius width mass">
    <link name="lift_wheel_link">
      <xacro:cylinder_inertial mass="${mass}" radius="${radius}" length="${width}" axis="y"/>
      <collision name="col">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
      </collision>
      <visual name="vis">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
        <material name="rubber_black"/>
      </visual>
    </link>
    <joint name="lift_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="lift_wheel_link"/>
      <origin xyz="${x} 0 ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="lift_wheel_link">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="diff_drive_plugin" params="wheel_separation wheel_radius update_rate max_linear_acceleration max_angular_acceleration">
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <odom_publish_frequency>${update_rate}</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <max_linear_acceleration>${max_linear_acceleration}</max_linear_acceleration>
        <min_linear_acceleration>-${max_linear_acceleration}</min_linear_acceleration>
        <max_angular_acceleration>${max_angular_acceleration}</max_angular_acceleration>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>lift_wheel_joint</joint_name>
        <use_force_commands>false</use_force_commands>
        <topic>/lift_wheel/cmd</topic>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
