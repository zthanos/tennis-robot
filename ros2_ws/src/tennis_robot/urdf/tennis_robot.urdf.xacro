<?xml version="1.0" encoding="UTF-8"?>
<robot name="tennis_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="components/materials.urdf.xacro"/>
  <xacro:include filename="components/base.urdf.xacro"/>
  <xacro:include filename="components/funnel.urdf.xacro"/>
  <xacro:include filename="components/basket.urdf.xacro"/>
  <xacro:include filename="components/drivetrain.urdf.xacro"/>
  <xacro:include filename="components/lidar.urdf.xacro"/>
  <xacro:include filename="components/oak_d.urdf.xacro"/>
  <xacro:include filename="components/ir_beam.urdf.xacro"/>
  <xacro:include filename="components/body_panels.urdf.xacro"/>

<xacro:property name="chassis_x" value="0.92"/> 
  <xacro:property name="chassis_y" value="0.58"/> 
  <xacro:property name="chassis_z" value="0.014"/> 
  <xacro:property name="chassis_mass" value="7.2"/> 

  <xacro:property name="wheel_x" value="-0.35"/> 
  <xacro:property name="wheel_y" value="0.35"/> 
  <xacro:property name="wheel_z" value="-0.09"/> 
  <xacro:property name="wheel_radius" value="0.09"/> 
  <xacro:property name="wheel_width" value="0.08"/> 
  <xacro:property name="wheel_mass" value="0.25"/> 
  <xacro:property name="wheel_separation" value="${2.0 * wheel_y}"/> 

  <xacro:property name="caster_x" value="0.31"/> 
  <xacro:property name="caster_y" value="0.35"/> 
  <xacro:property name="caster_z" value="-0.055"/> 
  <xacro:property name="caster_radius" value="0.055"/> 

  <xacro:property name="intake_x" value="0.62"/> 
  <xacro:property name="intake_z" value="0.095"/> 
  <xacro:property name="intake_radius" value="0.03"/> 
  <xacro:property name="intake_width" value="0.24"/> 

  <xacro:property name="lidar_xyz" value="-0.08 0 0.713"/> 
  <xacro:property name="lidar_rpy" value="0 0 0"/> 
  <xacro:property name="camera_xyz" value="0.535 0 0.443"/> 
  <xacro:property name="camera_rpy" value="0 0.22 0"/> 
  <xacro:property name="sensor_update_rate" value="31.25"/> 

  <xacro:property name="ir_x" value="0.54"/> 
  <xacro:property name="ir_y" value="0.105"/> 
  <xacro:property name="ir_z" value="0.053"/> 
  <xacro:property name="basket_ir_x" value="0.28"/> 
  <xacro:property name="basket_ir_y" value="0.105"/> 
  <xacro:property name="basket_ir_z" value="0.113"/> 

  <xacro:property name="max_linear_acceleration" value="2.0"/> 
  <xacro:property name="max_angular_acceleration" value="4.0"/>

  <xacro:tennis_robot_base
      chassis_x="${chassis_x}"
      chassis_y="${chassis_y}"
      chassis_z="${chassis_z}"
      chassis_mass="${chassis_mass}"/>

  <xacro:drive_wheel
      side="left"
      y="${wheel_y}"
      wheel_x="${wheel_x}"
      wheel_z="${wheel_z}"
      radius="${wheel_radius}"
      width="${wheel_width}"
      mass="${wheel_mass}"/>
      
  <xacro:drive_wheel
      side="right"
      y="-${wheel_y}"
      wheel_x="${wheel_x}"
      wheel_z="${wheel_z}"
      radius="${wheel_radius}"
      width="${wheel_width}"
      mass="${wheel_mass}"/>

  <xacro:intake_roller
      x="${intake_x}"
      z="${intake_z}"
      radius="${intake_radius}"
      width="${intake_width}"
      mass="0.20"/>

<xacro:intake_funnel parent="base_link" chassis_z="${chassis_z}"/> [cite: 4]
  <xacro:ball_basket parent="base_link"/> [cite: 4]

  <xacro:caster name="front_left" x="${caster_x}" y="-${caster_y}" z="${caster_z}" radius="${caster_radius}"/> [cite: 4]
  <xacro:caster name="front_right" x="${caster_x}" y="${caster_y}" z="${caster_z}" radius="${caster_radius}"/> [cite: 4]
  
  <xacro:rplidar_c1_mount
      parent="base_link"
      link_name="lidar_link"
      xyz="${lidar_xyz}"
      rpy="${lidar_rpy}"
      update_rate="${sensor_update_rate}"/> [cite: 4]

  <xacro:oak_d_lite_mount
      parent="base_link"
      link_name="camera_link"
      xyz="${camera_xyz}"
      rpy="${camera_rpy}"
      update_rate="${sensor_update_rate}"/> [cite: 4, 5]

  <xacro:ir_beam_sensor
      parent="base_link"
      link_name="ir_left_link"
      joint_name="ir_left_joint"
      xyz="${ir_x} -${ir_y} ${ir_z}"
      rpy="0 0 -1.5708"
      topic="/gz/ir_left"
      update_rate="${sensor_update_rate}"/> [cite: 5]
  <xacro:ir_beam_sensor
      parent="base_link"
      link_name="ir_right_link"
      joint_name="ir_right_joint"
      xyz="${ir_x} ${ir_y} ${ir_z}"
      rpy="0 0 1.5708"
      topic="/gz/ir_right"
      update_rate="${sensor_update_rate}"/>
  <xacro:ir_beam_sensor
      parent="base_link"
      link_name="basket_ir_left_link"
      joint_name="basket_ir_left_joint"
      xyz="${basket_ir_x} -${basket_ir_y} ${basket_ir_z}"
      rpy="0 0 -1.5708"
      topic="/gz/basket_ir_left"
      update_rate="${sensor_update_rate}"/> [cite: 5, 6]
  <xacro:ir_beam_sensor
      parent="base_link"
      link_name="basket_ir_right_link"
      joint_name="basket_ir_right_joint"
      xyz="${basket_ir_x} ${basket_ir_y} ${basket_ir_z}"
      rpy="0 0 1.5708"
      topic="/gz/basket_ir_right"
      update_rate="${sensor_update_rate}"/> [cite: 6]

  <xacro:diff_drive_plugin
      wheel_separation="${wheel_separation}"
      wheel_radius="${wheel_radius}"
      update_rate="${sensor_update_rate}"
      max_linear_acceleration="${max_linear_acceleration}"
      max_angular_acceleration="${max_angular_acceleration}"/> [cite: 6]

<xacro:robot_body_panels parent="base_link" chassis_z="${chassis_z}"/>      
</robot>
