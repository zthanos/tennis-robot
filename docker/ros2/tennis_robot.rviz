Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 500
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 30
      Cell Size: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: SimBalls
      Enabled: true
      Topic:
        Value: /sim/ball_markers
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: RollerContacts
      Enabled: true
      Topic:
        Value: /sim/roller_contact_markers
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Update Topic:
        Value: /map_updates
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.5
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 85; 0
      Position Transformer: XYZ
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: ""
    - Class: rviz_default_plugins/Image
      Name: IntakeDebugCamera
      Enabled: true
      Topic:
        Value: /camera/intake_debug/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Scale: 25
      X: 0
      Y: 0
      Angle: 0
    Saved:
      # Camera in front of the robot looking back at the scoop/roller; follows
      # the robot because Target Frame is base_link. Switch in the Views panel.
      - Class: rviz_default_plugins/Orbit
        Name: FrontFollow
        Target Frame: base_link
        Distance: 2.5
        Yaw: 0.0
        Pitch: 0.2
        Focal Point:
          X: 0.4
          Y: 0
          Z: 0.1
      # Behind-the-robot chase view (over-the-shoulder toward the intake).
      - Class: rviz_default_plugins/Orbit
        Name: ChaseFollow
        Target Frame: base_link
        Distance: 3.5
        Yaw: 3.1416
        Pitch: 0.45
        Focal Point:
          X: 0.5
          Y: 0
          Z: 0.1
Window Geometry:
  Height: 900
  Width: 1400
