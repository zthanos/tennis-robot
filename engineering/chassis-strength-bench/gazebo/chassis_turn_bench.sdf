<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="chassis_strength_bench">
    <physics name="deterministic_1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </visual>
      </link>
    </model>

    <model name="test_chassis">
      <pose>0 0 0.19 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>10.0</mass>
          <inertia>
            <ixx>0.45</ixx><iyy>0.55</iyy><izz>0.80</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <geometry><box><size>0.76 0.49 0.07</size></box></geometry>
        </collision>
        <visual name="base_visual">
          <geometry><box><size>0.76 0.49 0.07</size></box></geometry>
          <material><diffuse>0.15 0.47 0.78 1</diffuse></material>
        </visual>
      </link>

      <!-- Four identical D170 x W80 wheel envelopes at X=+/-220, Y=+/-350 mm. -->
      <link name="front_left_wheel"><pose>0.22 0.35 -0.105 1.570796 0 0</pose>
        <inertial><mass>0.7</mass><inertia><ixx>0.0015</ixx><iyy>0.0015</iyy><izz>0.0025</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.085</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.085</radius><length>0.08</length></cylinder></geometry></visual>
      </link>
      <link name="rear_left_wheel"><pose>-0.22 0.35 -0.105 1.570796 0 0</pose>
        <inertial><mass>0.7</mass><inertia><ixx>0.0015</ixx><iyy>0.0015</iyy><izz>0.0025</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.085</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.085</radius><length>0.08</length></cylinder></geometry></visual>
      </link>
      <link name="front_right_wheel"><pose>0.22 -0.35 -0.105 1.570796 0 0</pose>
        <inertial><mass>0.7</mass><inertia><ixx>0.0015</ixx><iyy>0.0015</iyy><izz>0.0025</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.085</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.085</radius><length>0.08</length></cylinder></geometry></visual>
      </link>
      <link name="rear_right_wheel"><pose>-0.22 -0.35 -0.105 1.570796 0 0</pose>
        <inertial><mass>0.7</mass><inertia><ixx>0.0015</ixx><iyy>0.0015</iyy><izz>0.0025</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.085</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.085</radius><length>0.08</length></cylinder></geometry></visual>
      </link>

      <joint name="front_left_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>3.73</effort><velocity>13</velocity></limit></axis><sensor name="wrench" type="force_torque"><always_on>true</always_on><update_rate>500</update_rate><force_torque><frame>child</frame><measure_direction>child_to_parent</measure_direction></force_torque></sensor></joint>
      <joint name="rear_left_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>3.73</effort><velocity>13</velocity></limit></axis><sensor name="wrench" type="force_torque"><always_on>true</always_on><update_rate>500</update_rate><force_torque><frame>child</frame><measure_direction>child_to_parent</measure_direction></force_torque></sensor></joint>
      <joint name="front_right_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>3.73</effort><velocity>13</velocity></limit></axis><sensor name="wrench" type="force_torque"><always_on>true</always_on><update_rate>500</update_rate><force_torque><frame>child</frame><measure_direction>child_to_parent</measure_direction></force_torque></sensor></joint>
      <joint name="rear_right_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>3.73</effort><velocity>13</velocity></limit></axis><sensor name="wrench" type="force_torque"><always_on>true</always_on><update_rate>500</update_rate><force_torque><frame>child</frame><measure_direction>child_to_parent</measure_direction></force_torque></sensor></joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_joint</left_joint><left_joint>rear_left_joint</left_joint>
        <right_joint>front_right_joint</right_joint><right_joint>rear_right_joint</right_joint>
        <wheel_separation>0.70</wheel_separation><wheel_radius>0.085</wheel_radius>
        <topic>/chassis_strength_bench/cmd_vel</topic>
        <max_linear_acceleration>2.0</max_linear_acceleration>
        <max_angular_acceleration>4.0</max_angular_acceleration>
        <odom_publish_frequency>100</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
