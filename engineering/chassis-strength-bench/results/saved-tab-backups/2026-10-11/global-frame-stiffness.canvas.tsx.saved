import { H1, H2, Stack, Grid, Stat, Text, Table, Callout, useHostTheme } from "cursor/canvas";
const rows = [
 ["PLA", "Χωρίς τραβέρσα", "0,4084", "0,00885"],
 ["PLA", "Μεσαία 50×30", "0,0990", "0,01214"],
 ["PLA", "Πλάτη ράμπας 25×20", "0,1958", "0,01126"],
 ["PETG", "Χωρίς τραβέρσα", "0,6257", "0,01352"],
 ["PETG", "Μεσαία 50×30", "0,1513", "0,01855"],
 ["PETG", "Πλάτη ράμπας 25×20", "0,2998", "0,01722"],
 ["PETG-CF", "Χωρίς τραβέρσα", "0,5219", "0,01130"],
 ["PETG-CF", "Μεσαία 50×30", "0,1265", "0,01551"],
 ["PETG-CF", "Πλάτη ράμπας 25×20", "0,2502", "0,01438"],
];
export default function GlobalFrame() {
 const t=useHostTheme();
 return <Stack gap={20} style={{padding:24,color:t.text.primary,background:t.bg.editor}}>
  <H1>Ελαστική σύγκριση σασί — πρώτο μοντέλο</H1>
  <Text>CalculiX · 27 λύσεις · 10 Οκτωβρίου 2026. Ιδανικά δεμένες ενώσεις, όχι πιστοποίηση εκτύπωσης.</Text>
  <Grid columns={3} gap={16}>
   <Stat label="Μείωση μέγιστης εμπρός μετατόπισης, PLA / λεπτή εμπρός" value="52%"/>
   <Stat label="Μείωση μέγιστης εμπρός μετατόπισης, PLA / μεσαία" value="76%"/>
   <Stat label="Μεταβολή μετατόπισης στα δύο λεπτότερα πλέγματα" value="≤0,382%"/>
  </Grid>
  <Callout tone="warning">Η λεπτή εμπρός ενίσχυση βοηθά στο συγκεκριμένο φορτίο, αλλά έχει περίπου διπλάσια μετατόπιση από τη μεγαλύτερη μεσαία. Η σχετική διαμήκης μετατόπιση ΔX δεν μειώνεται: ανακατανέμεται η παραμόρφωση. Δεν προκύπτει γενικό όριο αντοχής ή ασφαλές βάρος φορτίου.</Callout>
  <H2>Ίδια δοκιμή για τις τρεις διατάξεις</H2>
  <Text>Πίσω κόμβοι X=-165, Y=±220 mm πακτωμένοι σε έξι βαθμούς ελευθερίας. Εμπρός κόμβοι X=300 mm: αντίθετα Fx=±10 N και Mz=-1300 N·mm στον καθένα, λόγω απόστασης τροχού–δοκού 130 mm. Μοντέλο δοκών B32R / κοίλων διατομών BOX· προδιαγεγραμμένα φορτία, όχι φορτία από Gazebo.</Text>
  <Table headers={["Προσωρινό υλικό", "Διάταξη", "Μέγιστη εμπρός μετατόπιση (mm)", "Σχετική εμπρός ΔX (mm)"]} rows={rows}/>
  <Text>Πηγή: results/global_frame/comparison.json · πλέγμα 5 mm. Τα προφίλ E/ν είναι παραδοχές του έργου. Σύγκλιση με πλέγματα 20/10/5 mm· απλή PLA δοκός συμφωνεί με αναλυτικό πρότυπο εντός 0,086%.</Text>
  <H2>Όρια του μοντέλου</H2>
  <H2>Εμπρός τραβέρσα: διατήρηση πλάτους 50 mm</H2>
  <Stat label="Μείωση μέγιστης μετατόπισης PLA: εμπρός 50×20 έναντι 25×20" value="64,1%"/>
  <Table headers={["Προσωρινό υλικό", "Εμπρός 25×20 (mm)", "Εμπρός 50×20 (mm)", "Εμπρός 50×30 (mm)"]} rows={[
   ["PLA","0,195835","0,070308","0,055669"],
   ["PETG","0,299810","0,107627","0,085157"],
   ["PETG-CF","0,250234","0,089838","0,071133"]
  ]}/>
  <Text>Μέγιστη εμπρός μετατόπιση, ίδια φορτία και στηρίξεις. Πηγή: results/global_frame/front_width_study.json · 10 Οκτωβρίου 2026 · 45 λύσεις, πλέγμα αποτελεσμάτων 5 mm. Οι φαρδύτερες παραλλαγές μεγαλώνουν προς τα πίσω: κέντρο X=294,4 αντί 306,9 mm, ώστε η εμπρός παρειά να μείνει X=319,4 mm. Σύγκριση πλάτους και αναγκαίας μετατόπισης μαζί, όχι μόνο πλάτους.</Text>
  <Callout tone="warning">Το 50×20 είναι υποψήφιο για έλεγχο CAD, όχι έτοιμο STL. Τα 30 mm ύψους φτάνουν Z=52 mm και εμποδίζουν την υπάρχουσα πρόσβαση παξιμαδιών. Τα 20 mm φτάνουν Z=42 mm, με ονομαστικό κατακόρυφο διάκενο 2,3 mm. Η σχετική ΔX για PLA αυξάνεται από 0,011256 σε 0,012829 mm: το όφελος δεν αφορά όλες τις συνιστώσες.</Callout>
  <H2>Παραδοχές και περιορισμοί</H2>
  <Text>Ενώσεις πλήρως δεμένες. Δεν περιλαμβάνονται ανοχές, ολίσθηση μανικιών, προένταση βιδών, κόλλα, ανισοτροπία εκτύπωσης, W, τοπικές ενισχύσεις οροφής ή πέλματα Γ. Τα άκρα των νεύρων είναι εξιδανικευμένα στους άξονες δοκών. Ο έλεγχος σύγκλισης αφορά μετατοπίσεις, όχι τάσεις γύρω από οπές.</Text>
  <H2>Gazebo — χωριστός έλεγχος κίνησης</H2>
  <Table headers={["Παραμετρικό φορτίο (kg)", "Περιστροφή στο capture (°)", "Μετατόπιση στο capture (mm)"]} rows={[["0","531,23","0,108"],["10","533,09","0,168"]]}/>
  <Text>Ενιαίο rigid σασί και τέσσερις αισθητήρες τροχών, χωρίς εσωτερικό βρόχο. Οι στροφές εκτελέστηκαν. Ο χρόνος δημοσίευσης εντολών δεν είναι βαθμονομημένος· τα μεγέθη αυτά δεν είναι μετρήσεις ελαστικής ακαμψίας. Και στις δύο εκτελέσεις καταγράφηκε allocator warning στον τερματισμό, μετά την καταγραφή.</Text>
  <H2>Απόφαση πριν την εκτύπωση</H2>
  <Text>Η εμπρός 50×20 αξίζει νέο έλεγχο χωροθέτησης, Τ κόμβων και μανικιών. Δεν έχει αλλάξει το CAD παραγωγής. Πριν την εκτύπωση απαιτείται επιβεβαίωση εφαρμογής συνδέσεων και χώρου τροχών/ράμπας. Η πραγματική συμμόρφωση των ενώσεων παραμένει άγνωστη.</Text>
 </Stack>;
}
