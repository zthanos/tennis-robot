import { H1, H2, Stack, Grid, Stat, Text, Table, Callout, useHostTheme } from "cursor/canvas";

const dimensions = [
  ["Μεταξόνιο", "365 mm"], ["Δοκός", "50 × 30 mm"],
  ["Θέση μεσαίας τραβέρσας", "X=117,5 mm"],
  ["Τραβέρσα μεταξύ Τ", "270 mm · 2 × 135 mm"],
  ["Μανίκια", "8 συνολικά · 3 επιπλέον"],
  ["Κενό μεταξύ μανικιών μέσα σε κάθε μισό", "15 mm"],
  ["Δομή πάνω από έδαφος", "22 mm"],
  ["Μεταλλικό πέλμα → πέλμα Γ", "10 mm ονομαστικά"],
  ["Εσωτερική παρειά τροχού → εξωτερική δοκού", "65 mm ονομαστικά"],
];
const parts = [
  ["Πίσω motor, ανά πλευρά", "1+1", "144,5 cm³ / τεμάχιο", "200 × 50 × 30"],
  ["Εμπρός motor/Γ, ανά πλευρά", "1+1", "191,1 cm³ / τεμάχιο", "255 × 70 × 30"],
  ["Προέκταση με Τ, ανά πλευρά", "1+1", "139,1 cm³ / τεμάχιο", "165 × 110 × 30"],
  ["Πίσω γωνία, ανά πλευρά", "1+1", "118,7 cm³ / τεμάχιο", "81,5 × 81,5 × 23"],
  ["Πίσω τραβέρσα, μισό", "2", "103,4 cm³ / τεμάχιο", "50 × 220 × 30"],
  ["Μεσαία τραβέρσα, μισό", "2", "63,5 cm³ / τεμάχιο", "50 × 135 × 30"],
  ["Ίσιο μανίκι", "8", "53,4 cm³ / τεμάχιο", "120 × 43 × 23"],
  ["Στήριξη ράμπας, ανά πλευρά", "1+1", "15,0 cm³ / τεμάχιο", "10 × 105,5 × 22"],
  ["Κατακόρυφη βάση, μισό", "2", "159,4 cm³ / τεμάχιο", "50 × 245 × 190"],
];
const railScreen = [
  ["PLA", "0", "0,667"], ["PETG", "0", "1,023"], ["PETG-CF", "0", "0,853"],
  ["PLA", "5", "1,001"], ["PETG", "5", "1,535"], ["PETG-CF", "5", "1,279"],
  ["PLA", "10", "1,334"], ["PETG", "10", "2,046"], ["PETG-CF", "10", "1,705"],
];
export default function Measurements() {
  const theme = useHostTheme();
  return <Stack gap={20} style={{ padding:24, color:theme.text.primary, background:theme.bg.editor }}>
    <H1>Σασί με Τ — σύγκριση δύο διατάξεων</H1>
    <Text>Νέα παραλλαγή πλάτης ράμπας · 10 Οκτωβρίου 2026. Μετρήσεις CAD, όχι πιστοποίηση αντοχής.</Text>
    <Grid columns={3} gap={16}>
      <Stat label="Τρέχον σύνολο CAD, PLA" value="2,471 kg" />
      <Stat label="Λιγότερο PLA από τη μεσαία διάταξη" value="376 g" />
      <Stat label="Νέα τραβέρσα" value="25 × 20 mm" />
    </Grid>
    <Text>Πηγή: measure_ramp_back_design.py / νέα 14 STL. Ίδια γεωμετρική μέθοδος και πυκνότητα PLA 1240 kg/m³: διαφορά 13,2%, όχι αποτέλεσμα slicer.</Text>
    <Table headers={["Τρέχουσα παραλλαγή πλάτης ράμπας", "Τιμή"]} rows={[
      ["Κέντρο τραβέρσας", "X=306,9 mm"], ["Ύψος", "Z=22..42 mm"],
      ["Κενό κόλλας προς πλευρικά τοιχώματα ράμπας", "0,25 mm ονομαστικά"],
      ["Μικρή τραβέρσα", "2 μισά × 160 mm"],
      ["Μικρά μανίκια", "3 × (60 × 18 × 13 mm)"],
      ["Κοινά μανίκια που παραμένουν", "5"],
      ["Τομή με ράμπα / περιβλήματα τροχών intake", "Κενή στην τρέχουσα γεωμετρία"],
    ]}/>
    <Callout tone="warning">Η νέα θέση δεν λύνει τον κλειστό βρόχο των rigid-body engines. Οι νέοι σύνδεσμοι και η κόλλα χρειάζονται coupon. Η αποτελεσματικότητα θα κριθεί από σχετική μετατόπιση εμπρός κόμβων υπό ίδια αντίθετα φορτία: χωρίς ενίσχυση, μεσαία 50×30 και εμπρός 25×20.</Callout>
    <H2>Ιστορικές μετρήσεις μεσαίας τραβέρσας 50 × 30 mm</H2>
    <Grid columns={3} gap={16}>
      <Stat label="Πρόσθετο PLA ενίσχυσης" value="508 g" />
      <Stat label="Σύνολο τυπωμένων CAD στερεών, PLA" value="2,847 kg" />
      <Stat label="Επιπλέον γεωμετρικός όγκος" value="409,9 cm³" />
    </Grid>
    <Callout tone="warning">Οι μάζες είναι εκτιμήσεις πλήρως πυκνών στερεών CAD, όχι αποτελέσματα slicer. Δεν περιλαμβάνουν Γ, μέταλλα, μοτέρ, τροχούς, πλακέτα, μπαταρία, supports ή brim. Η ενίσχυση δεν είναι ακόμη τεκμηριωμένη ως ελαφριά ή επαρκώς άκαμπτη.</Callout>
    <Grid columns={2} gap={20}>
      <Stack gap={10}><H2>Διάταξη και διάκενα</H2><Table headers={["Μέγεθος", "Ονομαστική τιμή"]} rows={dimensions}/></Stack>
      <Stack gap={10}><H2>Σύγκριση μάζας υλικών</H2><Table headers={["Προφίλ", "Σύνολο στερεών (g)", "Ενίσχυση (g)"]} rows={[["PLA", "2847", "508"],["PETG", "2916", "521"],["PETG-CF", "2916", "521"]]}/><Text>Πυκνότητες από τα προσωρινά project profiles: 1240 / 1270 / 1270 kg/m³. Σύγκριση με το commit 2a5fedc, πριν τα Τ. Δεν είναι ζύγιση πραγματικών εξαρτημάτων.</Text></Stack>
    </Grid>
    <H2>Παραγόμενα εξαρτήματα</H2>
    <Table headers={["Εξάρτημα", "Πλήθος", "Όγκος CAD", "Περίβλημα (mm)"]} rows={parts}/>
    <Text>Πηγή: 15 εξαγόμενα STL · κλειστές ακμές mesh ελέγχθηκαν. Ο έλεγχος ακμών δεν αποκλείει αυτοτομές ή σφάλματα συναρμολόγησης. Το μήκος 255 mm του εμπρός κομματιού είναι οριακό για πλάκα 256 mm.</Text>
    <H2>Ενδεικτική κατακόρυφη κάμψη απλής δοκού</H2>
    <Table headers={["Προσωρινό υλικό", "Πρόσθετο φορτίο (kg)", "Υπολογισμένη βύθιση (mm)"]} rows={railScreen}/>
    <Text>Αναλυτικό screening, όχι μέτρηση: βάση 10 kg, ίση κατανομή στους τροχούς, κεντρικό φορτίο, συντελεστής 2, άνοιγμα 365 mm. Δεν μοντελοποιεί Τ, διαγώνια νεύρα, στρέβλωση πλαισίου, ανοχές, σύσφιξη ή στρώσεις εκτύπωσης. Δεν τεκμηριώνει την αύξηση ακαμψίας στις στροφές.</Text>
    <H2>Δοκιμή Gazebo — όριο εγκυρότητας</H2>
    <Callout tone="warning">Ο DART απέρριψε τη δεύτερη συγκόλληση της μεσαίας τραβέρσας. Τα καταγεγραμμένα φορτία του είναι μη έγκυρα για αυτό το πλαίσιο και δεν χρησιμοποιούνται εδώ ως αποτελέσματα αντοχής. Το έγκυρο SDF από μόνο του δεν εγγυάται ότι ο κινητήρας δημιούργησε όλες τις συνδέσεις.</Callout>
    <Text>Οι πρόσθετοι έλεγχοι δεν έδωσαν έγκυρο φορτίο: Bullet-Featherstone απορρίπτει τον βρόχο, κλασικός Bullet δίνει μηδενικά φορτία και μόνο 0,028° περιστροφή. Κανένα από αυτά δεν αποτελεί δοκιμή αντοχής.</Text>
    <H2>Το υπάρχον W διατηρείται</H2>
    <Text>W πάχους 2,4 mm στην κεντρική ζώνη 70 mm των motor modules. Τα socket άκρα 65 mm μένουν ελεύθερα για μανίκια. Οι κύριες δοκοί είναι ήδη κοίλες: το W εξοικονομεί υλικό μόνο αν αντικαθιστά συμπαγή περιοχή, όχι αν προστεθεί σε κενή κοιλότητα. Οι συμπαγείς φωλιές/εδράσεις βιδών δεν αλλάχθηκαν.</Text>
    <Text>Επόμενο τεκμήριο: φυσικό coupon Τ–μανικιού και δοκιμή παραμόρφωσης, ή ελαστική ανάλυση πλήρους πλαισίου με πραγματικές συνδέσεις και μάζες.</Text>
  </Stack>;
}
