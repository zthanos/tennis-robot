<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Isolated Phase-2 CAD-aligned module.  Deliberately separate from the
       legacy authoritative_flywheel_launcher_module: there is no lower panel.
       Frame coordinates use the nip as origin; the selected pivot is X=-55 mm. -->
  <xacro:macro name="cad_v3_flywheel_launcher_module"
      params="parent origin_xyz:='0 0 0'
              rotating_mass:=0.878977133503
              spin_inertia:=0.00508981582897 transverse_inertia:=0.00267808165955
              rotating_com_z:=0.0 fixed_mass:=2.85200336
              fixed_com_x:=-0.025 fixed_com_z:=0.0185061462201
              fixed_ixx:=0.03695 fixed_iyy:=0.01935 fixed_izz:=0.04147 fixed_ixz:=-0.00023
              max_vel:=320.0 effort:=0.62
              include_intake_guides:=false cheek_variant:='narrow' guide_design:='legacy'">
    <joint name="flywheel_launcher_mount_joint" type="fixed">
      <parent link="${parent}"/><child link="flywheel_launcher_frame_link"/>
      <origin xyz="${origin_xyz}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="flywheel_launcher_mount_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>

    <link name="flywheel_launcher_frame_link">
      <!-- Mass-transfer policy: the prior total fixed mass/CG/tensor are kept
           exactly.  The removed lower-panel allowance is redistributed into
           the upper plate/yokes lump; this is a conservation surrogate, not a
           claim for individual component masses.  Therefore no dynamics rerun
           is triggered by the collision/visual correction. -->
      <inertial>
        <origin xyz="${fixed_com_x} 0 ${fixed_com_z}"/>
        <mass value="${fixed_mass}"/>
        <inertia ixx="${fixed_ixx}" ixy="0" ixz="${fixed_ixz}"
                 iyy="${fixed_iyy}" iyz="0" izz="${fixed_izz}"/>
      </inertial>
      <!-- P2-40 CAD U=-15..170 mm, nip U=55 mm => X=-70..115 mm. -->
      <collision name="cad_upper_plate_col"><origin xyz="0.0225 0 0.043"/><geometry><box size="0.185 0.314 0.008"/></geometry></collision>
      <visual name="cad_upper_plate_vis"><origin xyz="0.0225 0 0.043"/><geometry><box size="0.185 0.314 0.008"/></geometry><material name="mount_gray"/></visual>
      <!-- Horizontal/vertical yoke webs and Ø24 trunnions, matching the CAD
           envelope.  Holes are intentionally not subtracted from collision. -->
      <xacro:macro name="cad_yoke" params="side">
        <collision name="cad_yoke_flange_${side}_col"><origin xyz="-0.045 ${side*0.1955} 0.043"/><geometry><box size="0.040 0.077 0.008"/></geometry></collision>
        <visual name="cad_yoke_flange_${side}_vis"><origin xyz="-0.045 ${side*0.1955} 0.043"/><geometry><box size="0.040 0.077 0.008"/></geometry><material name="mount_gray"/></visual>
        <collision name="cad_yoke_web_${side}_col"><origin xyz="-0.045 ${side*0.234} 0.0215"/><geometry><box size="0.040 0.008 0.043"/></geometry></collision>
        <visual name="cad_yoke_web_${side}_vis"><origin xyz="-0.045 ${side*0.234} 0.0215"/><geometry><box size="0.040 0.008 0.043"/></geometry><material name="mount_gray"/></visual>
        <collision name="cad_trunnion_${side}_col"><origin xyz="-0.055 ${side*0.234} 0" rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.012" length="0.012"/></geometry></collision>
        <visual name="cad_trunnion_${side}_vis"><origin xyz="-0.055 ${side*0.234} 0" rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.012" length="0.012"/></geometry><material name="mount_gray"/></visual>
      </xacro:macro>
      <xacro:cad_yoke side="1"/><xacro:cad_yoke side="-1"/>
      <xacro:macro name="cad_motor" params="side">
        <collision name="d5065_motor_${side}_col"><origin xyz="0 ${side*0.129} 0.0795"/><geometry><cylinder radius="0.025" length="0.065"/></geometry></collision>
        <visual name="d5065_motor_${side}_vis"><origin xyz="0 ${side*0.129} 0.0795"/><geometry><cylinder radius="0.025" length="0.065"/></geometry><material name="anthracite"/></visual>
      </xacro:macro>
      <xacro:cad_motor side="1"/><xacro:cad_motor side="-1"/>
      <!-- P2-43 fixtures mirror the frozen P2-40 cheek hull and moving
           throat floor in the nip-centred frame; they are not released CAD. -->
      <xacro:if value="${include_intake_guides}">
        <xacro:if value="${guide_design == 'legacy'}">
          <xacro:property name="cheek_entry_y" value="${0.110 if cheek_variant == 'wide' else 0.072}"/>
          <xacro:property name="cheek_centre_y" value="${(cheek_entry_y + 0.046)/2.0}"/>
          <xacro:property name="cheek_dx" value="0.077"/>
          <xacro:property name="cheek_dy" value="${cheek_entry_y - 0.046}"/>
          <xacro:property name="cheek_length" value="${sqrt(cheek_dx*cheek_dx + cheek_dy*cheek_dy) + 0.010}"/>
          <xacro:property name="cheek_yaw" value="${atan2(cheek_dy, cheek_dx)}"/>
          <xacro:macro name="intake_cheek_legacy" params="side">
            <collision name="intake_cheek_${side}_col"><origin xyz="0.0715 ${side*cheek_centre_y} 0.0135" rpy="0 0 ${side*cheek_yaw}"/><geometry><box size="${cheek_length} 0.004 0.060"/></geometry></collision>
            <visual name="intake_cheek_${side}_vis"><origin xyz="0.0715 ${side*cheek_centre_y} 0.0135" rpy="0 0 ${side*cheek_yaw}"/><geometry><box size="${cheek_length} 0.004 0.060"/></geometry><material name="electronics_blue"/></visual>
          </xacro:macro>
          <xacro:intake_cheek_legacy side="1"/><xacro:intake_cheek_legacy side="-1"/>
          <collision name="intake_moving_guide_floor_col"><origin xyz="-0.101 0 -0.0175" rpy="0 -0.201762 0"/><geometry><box size="0.050 0.088 0.004"/></geometry></collision>
          <visual name="intake_moving_guide_floor_vis"><origin xyz="-0.101 0 -0.0175" rpy="0 -0.201762 0"/><geometry><box size="0.050 0.088 0.004"/></geometry><material name="frame_blue"/></visual>
        </xacro:if>
        <xacro:if value="${guide_design == 'p244'}">
          <!-- Both candidates end ahead of the tyre envelope (X=+105 mm),
               leaving the front-inner wheel quadrants exposed. -->
          <xacro:property name="p244_front_x" value="${0.180 if cheek_variant == 'exposed_short' else 0.220}"/>
          <xacro:property name="p244_front_y" value="0.125"/>
          <xacro:property name="p244_rear_x" value="0.105"/>
          <xacro:property name="p244_rear_y" value="0.080"/>
          <xacro:property name="p244_dx" value="${p244_front_x-p244_rear_x}"/>
          <xacro:property name="p244_dy" value="${p244_front_y-p244_rear_y}"/>
          <xacro:property name="p244_length" value="${sqrt(p244_dx*p244_dx+p244_dy*p244_dy)}"/>
          <xacro:property name="p244_yaw" value="${atan2(p244_dy,p244_dx)}"/>
          <xacro:macro name="intake_cheek_p244" params="side">
            <collision name="intake_cheek_${side}_col"><origin xyz="${(p244_front_x+p244_rear_x)/2} ${side*(p244_front_y+p244_rear_y)/2} 0.010" rpy="0 0 ${side*p244_yaw}"/><geometry><box size="${p244_length} 0.004 0.052"/></geometry></collision>
            <visual name="intake_cheek_${side}_vis"><origin xyz="${(p244_front_x+p244_rear_x)/2} ${side*(p244_front_y+p244_rear_y)/2} 0.010" rpy="0 0 ${side*p244_yaw}"/><geometry><box size="${p244_length} 0.004 0.052"/></geometry><material name="electronics_blue"/></visual>
          </xacro:macro>
          <xacro:intake_cheek_p244 side="1"/><xacro:intake_cheek_p244 side="-1"/>
        </xacro:if>
        <xacro:if value="${guide_design == 'p257'}">
          <!-- P2-57 replaceable printed front parts.  The wheel/nip/rail core
               is unchanged.  Mouth values are clear full widths.  A 6 mm
               round leading post and mu=0.05 in the bench represent the
               smooth low-friction nose treatment. -->
          <xacro:property name="p257_mouth" value="${0.140 if cheek_variant.startswith('p257_stagger_') else (0.090 if cheek_variant == 'p257_shield_m90' else (0.110 if cheek_variant == 'p257_shield_m110' else 0.100))}"/>
          <xacro:property name="p257_half" value="${p257_mouth/2.0}"/>
          <xacro:property name="p257_rear_x" value="0.105"/>
          <xacro:property name="p257_rear_y" value="0.046"/>
          <xacro:property name="p257_front_x" value="0.180"/>
          <xacro:property name="p257_dx" value="${p257_front_x-p257_rear_x}"/>
          <xacro:property name="p257_dy" value="${p257_half-p257_rear_y}"/>
          <xacro:property name="p257_length" value="${sqrt(p257_dx*p257_dx+p257_dy*p257_dy)}"/>
          <xacro:property name="p257_yaw" value="${atan2(p257_dy,p257_dx)}"/>
          <xacro:property name="p257_has_shield" value="${cheek_variant != 'p257_stagger_open'}"/>
          <xacro:property name="p257_is_stagger" value="${cheek_variant == 'p257_stagger_open' or cheek_variant == 'p257_stagger_shield'}"/>
          <xacro:macro name="intake_cheek_p257" params="side">
            <collision name="p257_cheek_${side}_col"><origin xyz="${(p257_front_x+p257_rear_x)/2} ${side*(p257_half+p257_rear_y)/2} 0.020" rpy="0 0 ${side*p257_yaw}"/><geometry><box size="${p257_length} 0.006 0.060"/></geometry></collision>
            <visual name="p257_cheek_${side}_vis"><origin xyz="${(p257_front_x+p257_rear_x)/2} ${side*(p257_half+p257_rear_y)/2} 0.020" rpy="0 0 ${side*p257_yaw}"/><geometry><box size="${p257_length} 0.006 0.060"/></geometry><material name="electronics_blue"/></visual>
            <collision name="p257_cheek_${side}_nose_col"><origin xyz="${p257_front_x} ${side*p257_half} 0.020"/><geometry><cylinder radius="0.006" length="0.060"/></geometry></collision>
            <visual name="p257_cheek_${side}_nose_vis"><origin xyz="${p257_front_x} ${side*p257_half} 0.020"/><geometry><cylinder radius="0.006" length="0.060"/></geometry><material name="electronics_blue"/></visual>
          </xacro:macro>
          <xacro:intake_cheek_p257 side="1"/><xacro:intake_cheek_p257 side="-1"/>
          <xacro:if value="${p257_is_stagger}">
            <!-- +Y cheek begins 70 mm farther forward; its raised lower edge
                 preserves the -10 degree ground-clearance sweep.  Its nose is
                 outboard, so the ball meets the long smooth face rather than
                 a blunt transverse end. -->
            <xacro:property name="p257_stagger_dx" value="0.070"/>
            <xacro:property name="p257_stagger_rear_y" value="0.055"/>
            <xacro:property name="p257_stagger_dy" value="${0.100-p257_stagger_rear_y}"/>
            <xacro:property name="p257_stagger_len" value="${sqrt(p257_stagger_dx*p257_stagger_dx+p257_stagger_dy*p257_stagger_dy)}"/>
            <xacro:property name="p257_stagger_yaw" value="${atan2(p257_stagger_dy,p257_stagger_dx)}"/>
            <collision name="p257_stagger_extension_col"><origin xyz="0.215 ${(0.100+p257_stagger_rear_y)/2} 0.035" rpy="0 0 ${p257_stagger_yaw}"/><geometry><box size="${p257_stagger_len} 0.006 0.060"/></geometry></collision>
            <visual name="p257_stagger_extension_vis"><origin xyz="0.215 ${(0.100+p257_stagger_rear_y)/2} 0.035" rpy="0 0 ${p257_stagger_yaw}"/><geometry><box size="${p257_stagger_len} 0.006 0.060"/></geometry><material name="electronics_blue"/></visual>
            <collision name="p257_stagger_nose_col"><origin xyz="0.250 0.100 0.035"/><geometry><cylinder radius="0.003" length="0.060"/></geometry></collision>
            <visual name="p257_stagger_nose_vis"><origin xyz="0.250 0.100 0.035"/><geometry><cylinder radius="0.003" length="0.060"/></geometry><material name="electronics_blue"/></visual>
          </xacro:if>
          <xacro:if value="${p257_has_shield}">
            <xacro:macro name="p257_shield" params="side">
              <collision name="p257_shield_${side}_col"><origin xyz="0.130 ${side*0.118} 0.018"/><geometry><box size="0.006 0.144 0.060"/></geometry></collision>
              <visual name="p257_shield_${side}_vis"><origin xyz="0.130 ${side*0.118} 0.018"/><geometry><box size="0.006 0.144 0.060"/></geometry><material name="frame_blue"/></visual>
              <collision name="p257_shield_${side}_inner_cap_col"><origin xyz="0.130 ${side*0.046} 0.018"/><geometry><cylinder radius="0.006" length="0.060"/></geometry></collision>
            </xacro:macro>
            <xacro:p257_shield side="1"/><xacro:p257_shield side="-1"/>
          </xacro:if>
        </xacro:if>
      </xacro:if>
    </link>

    <xacro:provisional_candidate_flywheel side="left" parent="flywheel_launcher_frame_link"
      y="0.129" radius="0.100" width="0.060" rotating_mass="${rotating_mass}"
      spin_inertia="${spin_inertia}" transverse_inertia="${transverse_inertia}"
      com_z="${rotating_com_z}" max_vel="${max_vel}" effort="${effort}"/>
    <xacro:provisional_candidate_flywheel side="right" parent="flywheel_launcher_frame_link"
      y="-0.129" radius="0.100" width="0.060" rotating_mass="${rotating_mass}"
      spin_inertia="${spin_inertia}" transverse_inertia="${transverse_inertia}"
      com_z="${rotating_com_z}" max_vel="${max_vel}" effort="${effort}"/>
  </xacro:macro>
</robot>
