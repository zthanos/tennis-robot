<?xml version="1.0"?>
<!--
  Tennis Court model.
  Dimensions from CLAUDE.md and tennis_court.wbt:
    Court playing area:  23.77 × 10.97 m
    Net at x = 0, height 0.914 m at center (0.107 m at posts)
    Net posts at (0, ±5.485, 0)
    Baselines at x = ±11.885 m
    Service lines at x = ±6.4 m
    Perimeter fence inner wall: x = ±12.96 m, y = ±6.46 m
    Floodlight poles at court corners (approx x = ±13.5, y = ±7.0)
-->
<sdf version="1.9">
<model name="tennis_court">
  <static>true</static>
  <pose>0 0 0 0 0 0</pose>

  <!-- ── GROUND SURFACE (red clay) ──────────────────────────────── -->
  <link name="ground">
    <collision name="col">
      <geometry><box><size>30 20 0.02</size></box></geometry>
    </collision>
    <visual name="vis">
      <pose>0 0 -0.01 0 0 0</pose>
      <geometry><box><size>30 20 0.02</size></box></geometry>
      <material>
        <ambient>0.72 0.36 0.18 1</ambient>
        <diffuse>0.72 0.36 0.18 1</diffuse>
      </material>
    </visual>
  </link>

  <!-- ── COURT LINES (visual only) ──────────────────────────────── -->
  <!-- Baselines -->
  <link name="baseline_east">
    <pose>11.885 0 0.001 0 0 0</pose>
    <visual name="vis"><geometry><box><size>0.05 10.97 0.002</size></box></geometry>
      <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
  </link>
  <link name="baseline_west">
    <pose>-11.885 0 0.001 0 0 0</pose>
    <visual name="vis"><geometry><box><size>0.05 10.97 0.002</size></box></geometry>
      <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
  </link>
  <!-- Sidelines -->
  <link name="sideline_north">
    <pose>0 5.485 0.001 0 0 0</pose>
    <visual name="vis"><geometry><box><size>23.77 0.05 0.002</size></box></geometry>
      <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
  </link>
  <link name="sideline_south">
    <pose>0 -5.485 0.001 0 0 0</pose>
    <visual name="vis"><geometry><box><size>23.77 0.05 0.002</size></box></geometry>
      <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
  </link>
  <!-- Service lines -->
  <link name="service_east">
    <pose>6.4 0 0.001 0 0 0</pose>
    <visual name="vis"><geometry><box><size>0.05 8.23 0.002</size></box></geometry>
      <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
  </link>
  <link name="service_west">
    <pose>-6.4 0 0.001 0 0 0</pose>
    <visual name="vis"><geometry><box><size>0.05 8.23 0.002</size></box></geometry>
      <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
  </link>
  <!-- Centre service line -->
  <link name="centre_service">
    <pose>0 0 0.001 0 0 0</pose>
    <visual name="vis"><geometry><box><size>12.8 0.05 0.002</size></box></geometry>
      <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
  </link>

  <!-- ── NET POSTS ────────────────────────────────────────────────── -->
  <link name="net_post_north">
    <pose>0 5.485 0.557 0 0 0</pose>
    <collision name="col"><geometry><cylinder><radius>0.025</radius><length>1.114</length></cylinder></geometry></collision>
    <visual name="vis"><geometry><cylinder><radius>0.025</radius><length>1.114</length></cylinder></geometry>
      <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
  </link>
  <link name="net_post_south">
    <pose>0 -5.485 0.557 0 0 0</pose>
    <collision name="col"><geometry><cylinder><radius>0.025</radius><length>1.114</length></cylinder></geometry></collision>
    <visual name="vis"><geometry><cylinder><radius>0.025</radius><length>1.114</length></cylinder></geometry>
      <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
  </link>

  <!-- ── NET (collision + visual) ───────────────────────────────── -->
  <!-- Simplified as a thin wall; real net height 0.914 m at center -->
  <link name="net_wall">
    <pose>0 0 0.457 0 0 0</pose>
    <collision name="col">
      <geometry><box><size>0.02 10.97 0.914</size></box></geometry>
    </collision>
    <visual name="vis">
      <geometry><box><size>0.02 10.97 0.914</size></box></geometry>
      <material><ambient>0.1 0.1 0.1 0.6</ambient><diffuse>0.1 0.1 0.1 0.6</diffuse></material>
    </visual>
  </link>

  <!-- ── PERIMETER FENCE (collision + visual) ──────────────────── -->
  <!-- East wall: x = +13.0, spans y ±6.5, h = 4 m -->
  <link name="fence_east">
    <pose>13.0 0 2.0 0 0 0</pose>
    <collision name="col"><geometry><box><size>0.08 13.0 4.0</size></box></geometry></collision>
    <visual name="vis"><geometry><box><size>0.08 13.0 4.0</size></box></geometry>
      <material><ambient>0.2 0.4 0.2 0.7</ambient><diffuse>0.2 0.4 0.2 0.7</diffuse></material></visual>
  </link>
  <!-- West wall -->
  <link name="fence_west">
    <pose>-13.0 0 2.0 0 0 0</pose>
    <collision name="col"><geometry><box><size>0.08 13.0 4.0</size></box></geometry></collision>
    <visual name="vis"><geometry><box><size>0.08 13.0 4.0</size></box></geometry>
      <material><ambient>0.2 0.4 0.2 0.7</ambient><diffuse>0.2 0.4 0.2 0.7</diffuse></material></visual>
  </link>
  <!-- North wall -->
  <link name="fence_north">
    <pose>0 6.5 2.0 0 0 0</pose>
    <collision name="col"><geometry><box><size>26.08 0.08 4.0</size></box></geometry></collision>
    <visual name="vis"><geometry><box><size>26.08 0.08 4.0</size></box></geometry>
      <material><ambient>0.2 0.4 0.2 0.7</ambient><diffuse>0.2 0.4 0.2 0.7</diffuse></material></visual>
  </link>
  <!-- South wall -->
  <link name="fence_south">
    <pose>0 -6.5 2.0 0 0 0</pose>
    <collision name="col"><geometry><box><size>26.08 0.08 4.0</size></box></geometry></collision>
    <visual name="vis"><geometry><box><size>26.08 0.08 4.0</size></box></geometry>
      <material><ambient>0.2 0.4 0.2 0.7</ambient><diffuse>0.2 0.4 0.2 0.7</diffuse></material></visual>
  </link>

  <!-- ── FLOODLIGHT POLES (LiDAR survey targets) ───────────────── -->
  <!-- 4 corner poles + 2 mid-court poles -->
  <link name="pole_ne"><pose>13.5 7.0 5.0 0 0 0</pose>
    <collision name="col"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry></collision>
    <visual name="vis"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry>
      <material><ambient>0.3 0.3 0.35 1</ambient></material></visual>
  </link>
  <link name="pole_nw"><pose>-13.5 7.0 5.0 0 0 0</pose>
    <collision name="col"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry></collision>
    <visual name="vis"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry>
      <material><ambient>0.3 0.3 0.35 1</ambient></material></visual>
  </link>
  <link name="pole_se"><pose>13.5 -7.0 5.0 0 0 0</pose>
    <collision name="col"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry></collision>
    <visual name="vis"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry>
      <material><ambient>0.3 0.3 0.35 1</ambient></material></visual>
  </link>
  <link name="pole_sw"><pose>-13.5 -7.0 5.0 0 0 0</pose>
    <collision name="col"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry></collision>
    <visual name="vis"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry>
      <material><ambient>0.3 0.3 0.35 1</ambient></material></visual>
  </link>

</model>
</sdf>
