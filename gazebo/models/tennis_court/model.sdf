<?xml version="1.0"?>
<!--
  Tennis Court model Ã¢â‚¬â€ Gazebo Harmonic SDF 1.9
  Runtime visuals use Gazebo-native primitives for WSLg stability. The source
  SketchUp/DAE model remains the material and dimension reference.
  Collision geometry uses simple boxes for physics/LiDAR stability.

  Standard dimensions (ITF regulation):
    Doubles width: 10.97 m  (sidelines at y = Ã‚Â±5.485 m)
    Singles width:  8.23 m  (sidelines at y = Ã‚Â±4.115 m)
    Length:        23.77 m  (baselines at x = Ã‚Â±11.885 m)
    Service lines: x = Ã‚Â±6.4 m
    Net posts:     y = Ã‚Â±5.65 m (0.165 m outside doubles sideline)
    Net height:    0.914 m at centre, 1.07 m at posts
    Fences:        x = Ã‚Â±14.5 m,  y = Ã‚Â±7.5 m

  DAE-derived material palette:
    mat_2 dark net/metal:                0.11373 0.11373 0.11373
-->
<sdf version="1.9">
<model name="tennis_court">
  <static>true</static>

  <!-- Ã¢â€â‚¬Ã¢â€â‚¬ OUTER GROUND (grass/vegetation outside the fence) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ -->
  <link name="outer_ground">
    <visual name="vis">
      <pose>0 0 -0.014 0 0 0</pose>
      <geometry><box><size>80 60 0.02</size></box></geometry>
      <material>
        <ambient>0.16 0.28 0.12 1</ambient>
        <diffuse>0.18 0.32 0.14 1</diffuse>
        <specular>0.02 0.04 0.02 1</specular>
      </material>
    </visual>
  </link>

  <!-- Ã¢â€â‚¬Ã¢â€â‚¬ COURT SURFACE Ã¢â‚¬â€ DAE mat_1 main flat surface tone Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ -->
  <link name="ground">
    <collision name="col">
      <geometry><box><size>33.0 17.0 0.02</size></box></geometry>
      <!-- Clay court surface friction for wheel contact. -->
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>1.5</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <visual name="vis">
      <pose>0 0 -0.01 0 0 0</pose>
      <geometry><box><size>33.0 17.0 0.02</size></box></geometry>
      <material>
        <ambient>0.64 0.20 0.09 1</ambient>
        <diffuse>0.68 0.23 0.11 1</diffuse>
        <specular>0.08 0.08 0.08 1</specular>
      </material>
    </visual>
  </link>

