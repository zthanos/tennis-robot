  <!-- Ã¢â€â‚¬Ã¢â€â‚¬ PERIMETER FENCES Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
       Collision: box (stable for LiDAR raycasting).
       Visual: DAE mesh with 4 cm rhombus chain-link pattern.

       East/West fences use fence_long.dae (width=15 m Ãƒâ€” height=4 m).
         Link pose yaw = Ã¢Ë†â€™Ãâ‚¬/2 so mesh X (horizontal) Ã¢â€ â€™ world Ã¢Ë†â€™Y.
         Collision box in local frame: size (15, 0.08, 4), centre (0, 0, 2).

       North/South fences use fence_wide.dae (width=29.08 m Ãƒâ€” height=4 m).
         Link pose yaw = 0 (mesh X already = world X).
         Collision box: size (29.08, 0.08, 4), centre (0, 0, 2).              -->

  <link name="fence_east">
    <pose>16.5 0 0 0 0 -1.5708</pose>
    <collision name="col">
      <pose>0 0 2.0 0 0 0</pose>
      <geometry><box><size>17.0 0.08 4.0</size></box></geometry>
    </collision>
    <!-- Near-invisible solid pane so the gpu_lidar (which raycasts against
         visual GEOMETRY, ignoring alpha) gets dense returns from the fence.
         The chain-link DAE has real 4 cm holes, so ~80% of rays pass through
         and SLAM never sees the boundary. -->
    <visual name="lidar_screen">
      <pose>0 0 2.0 0 0 0</pose>
      <geometry><box><size>17.0 0.02 4.0</size></box></geometry>
      <material>
        <ambient>0.08 0.20 0.10 0.05</ambient>
        <diffuse>0.08 0.20 0.10 0.05</diffuse>
      </material>
      <transparency>0.95</transparency>
    </visual>
    <visual name="v">
      <geometry><mesh><uri>model://tennis_court/meshes/fence_long.dae</uri></mesh></geometry>
      <!-- Transparent chain-link fence mesh with 4 cm rhombus pattern. -->
      <material>
        <double_sided>true</double_sided>
        <ambient>0.06 0.16 0.08 0.88</ambient>
        <diffuse>0.08 0.20 0.10 0.88</diffuse>
        <specular>0.04 0.08 0.04 1</specular>
      </material>
    </visual>
  </link>

  <link name="fence_west">
    <pose>-16.5 0 0 0 0 -1.5708</pose>
    <collision name="col">
      <pose>0 0 2.0 0 0 0</pose>
      <geometry><box><size>17.0 0.08 4.0</size></box></geometry>
    </collision>
    <visual name="lidar_screen">
      <pose>0 0 2.0 0 0 0</pose>
      <geometry><box><size>17.0 0.02 4.0</size></box></geometry>
      <material>
        <ambient>0.08 0.20 0.10 0.05</ambient>
        <diffuse>0.08 0.20 0.10 0.05</diffuse>
      </material>
      <transparency>0.95</transparency>
    </visual>
    <visual name="v">
      <geometry><mesh><uri>model://tennis_court/meshes/fence_long.dae</uri></mesh></geometry>
      <!-- Transparent chain-link fence mesh with 4 cm rhombus pattern. -->
      <material>
        <double_sided>true</double_sided>
        <ambient>0.06 0.16 0.08 0.88</ambient>
        <diffuse>0.08 0.20 0.10 0.88</diffuse>
        <specular>0.04 0.08 0.04 1</specular>
      </material>
    </visual>
  </link>

  <link name="fence_north">
    <pose>0 8.5 0 0 0 0</pose>
    <collision name="col">
      <pose>0 0 2.0 0 0 0</pose>
      <geometry><box><size>33.08 0.08 4.0</size></box></geometry>
    </collision>
    <visual name="lidar_screen">
      <pose>0 0 2.0 0 0 0</pose>
      <geometry><box><size>33.08 0.02 4.0</size></box></geometry>
