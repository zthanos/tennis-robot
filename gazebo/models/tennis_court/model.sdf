<?xml version="1.0"?>
<!--
  Tennis Court model — Gazebo Harmonic SDF 1.9
  Fence and net use DAE mesh geometry (generated by gazebo/scripts/gen_court_meshes.py).
  Collision geometry uses simple boxes for physics/LiDAR stability.

  Standard dimensions (ITF regulation):
    Doubles width: 10.97 m  (sidelines at y = ±5.485 m)
    Singles width:  8.23 m  (sidelines at y = ±4.115 m)
    Length:        23.77 m  (baselines at x = ±11.885 m)
    Service lines: x = ±6.4 m
    Net posts:     y = ±5.65 m (0.165 m outside doubles sideline)
    Net height:    0.914 m at centre, 1.07 m at posts
    Fences:        x = ±14.5 m,  y = ±7.5 m

  Mesh coordinate convention (all panels in local XZ plane, Y ≈ 0):
    X = horizontal width (centred), Z = height from 0.
    SDF link pose applies a rotation so the mesh aligns correctly in world.
      - North/South fences: yaw = 0   (mesh X already = world X)
      - East/West fences:   yaw = −π/2 (mesh X → world −Y, mesh Y → world X)
      - Net:                yaw = −π/2 (mesh X → world −Y, mesh Y → world X)
-->
<sdf version="1.9">
<model name="tennis_court">
  <static>true</static>

  <!-- ── OUTER GROUND (grass/vegetation outside the fence) ───────────── -->
  <link name="outer_ground">
    <visual name="vis">
      <pose>0 0 -0.014 0 0 0</pose>
      <geometry><box><size>80 60 0.02</size></box></geometry>
      <material>
        <ambient>0.16 0.28 0.12 1</ambient>
        <diffuse>0.18 0.32 0.14 1</diffuse>
        <specular>0.02 0.04 0.02 1</specular>
      </material>
    </visual>
  </link>

  <!-- ── RED CLAY — fills the full fence-enclosed area ────────────────── -->
  <!-- Darker, richer terracotta matching reference photo -->
  <link name="ground">
    <collision name="col">
      <geometry><box><size>29.0 15.0 0.02</size></box></geometry>
    </collision>
    <visual name="vis">
      <pose>0 0 -0.01 0 0 0</pose>
      <geometry><box><size>29.0 15.0 0.02</size></box></geometry>
      <material>
        <ambient>0.64 0.20 0.09 1</ambient>
        <diffuse>0.68 0.23 0.11 1</diffuse>
        <specular>0.05 0.03 0.02 1</specular>
      </material>
    </visual>
  </link>

  <!-- ── COURT LINES (visual only) ──────────────────────────────────────── -->
  <link name="baseline_east"><pose>11.885 0 0.001 0 0 0</pose>
    <visual name="v"><geometry><box><size>0.05 10.97 0.003</size></box></geometry>
      <material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual></link>
  <link name="baseline_west"><pose>-11.885 0 0.001 0 0 0</pose>
    <visual name="v"><geometry><box><size>0.05 10.97 0.003</size></box></geometry>
      <material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual></link>
  <link name="doubles_sideline_north"><pose>0 5.485 0.001 0 0 0</pose>
    <visual name="v"><geometry><box><size>23.77 0.05 0.003</size></box></geometry>
      <material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual></link>
  <link name="doubles_sideline_south"><pose>0 -5.485 0.001 0 0 0</pose>
    <visual name="v"><geometry><box><size>23.77 0.05 0.003</size></box></geometry>
      <material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual></link>
  <link name="singles_sideline_north"><pose>0 4.115 0.001 0 0 0</pose>
    <visual name="v"><geometry><box><size>23.77 0.05 0.003</size></box></geometry>
      <material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual></link>
  <link name="singles_sideline_south"><pose>0 -4.115 0.001 0 0 0</pose>
    <visual name="v"><geometry><box><size>23.77 0.05 0.003</size></box></geometry>
      <material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual></link>
  <link name="service_line_east"><pose>6.4 0 0.001 0 0 0</pose>
    <visual name="v"><geometry><box><size>0.05 8.23 0.003</size></box></geometry>
      <material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual></link>
  <link name="service_line_west"><pose>-6.4 0 0.001 0 0 0</pose>
    <visual name="v"><geometry><box><size>0.05 8.23 0.003</size></box></geometry>
      <material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual></link>
  <link name="centre_service_line"><pose>0 0 0.001 0 0 0</pose>
    <visual name="v"><geometry><box><size>12.8 0.05 0.003</size></box></geometry>
      <material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual></link>
  <link name="centre_mark_east"><pose>11.835 0 0.001 0 0 0</pose>
    <visual name="v"><geometry><box><size>0.10 0.05 0.003</size></box></geometry>
      <material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual></link>
  <link name="centre_mark_west"><pose>-11.835 0 0.001 0 0 0</pose>
    <visual name="v"><geometry><box><size>0.10 0.05 0.003</size></box></geometry>
      <material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual></link>

  <!-- ── NET POSTS ───────────────────────────────────────────────────────── -->
  <link name="net_post_north"><pose>0 5.65 0.535 0 0 0</pose>
    <collision name="col"><geometry><cylinder><radius>0.025</radius><length>1.07</length></cylinder></geometry></collision>
    <visual name="v"><geometry><cylinder><radius>0.025</radius><length>1.07</length></cylinder></geometry>
      <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse><specular>0.4 0.4 0.4 1</specular></material></visual></link>
  <link name="net_post_south"><pose>0 -5.65 0.535 0 0 0</pose>
    <collision name="col"><geometry><cylinder><radius>0.025</radius><length>1.07</length></cylinder></geometry></collision>
    <visual name="v"><geometry><cylinder><radius>0.025</radius><length>1.07</length></cylinder></geometry>
      <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse><specular>0.4 0.4 0.4 1</specular></material></visual></link>

  <!-- ── NET ───────────────────────────────────────────────────────────────
       Collision: solid box (robot cannot cross, LiDAR detects it).
       Visual: DAE mesh with horizontal ropes + vertical strings.
       Link pose rotated −π/2 around Z so mesh X (±5.65 m) → world ∓Y.  -->
  <link name="net_wall">
    <pose>0 0 0 0 0 -1.5708</pose>

    <!-- Collision box centred in local frame -->
    <collision name="col">
      <pose>0 0 0.457 0 0 0</pose>
      <geometry><box><size>11.3 0.02 0.914</size></box></geometry>
    </collision>

    <!-- Rope mesh — off-white/cream (matches reference photo net) -->
    <visual name="net_ropes">
      <pose>0 0 0 0 0 0</pose>
      <geometry>
        <mesh><uri>model://tennis_court/meshes/net_mesh.dae</uri></mesh>
      </geometry>
      <material>
        <ambient>0.88 0.86 0.80 0.92</ambient>
        <diffuse>0.92 0.90 0.84 0.92</diffuse>
        <specular>0.15 0.14 0.12 1</specular>
      </material>
    </visual>

    <!-- White top band: a flat box at z = 0.914 − 0.031 = 0.883, height 0.063 m -->
    <visual name="top_band">
      <pose>0 0 0.883 0 0 0</pose>
      <geometry><box><size>11.3 0.02 0.063</size></box></geometry>
      <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
    </visual>
  </link>

  <!-- ── PERIMETER FENCES ──────────────────────────────────────────────────
       Collision: box (stable for LiDAR raycasting).
       Visual: DAE mesh with 4 cm rhombus chain-link pattern.

       East/West fences use fence_long.dae (width=15 m × height=4 m).
         Link pose yaw = −π/2 so mesh X (horizontal) → world −Y.
         Collision box in local frame: size (15, 0.08, 4), centre (0, 0, 2).

       North/South fences use fence_wide.dae (width=29.08 m × height=4 m).
         Link pose yaw = 0 (mesh X already = world X).
         Collision box: size (29.08, 0.08, 4), centre (0, 0, 2).              -->

  <link name="fence_east">
    <pose>14.5 0 0 0 0 -1.5708</pose>
    <collision name="col">
      <pose>0 0 2.0 0 0 0</pose>
      <geometry><box><size>15.0 0.08 4.0</size></box></geometry>
    </collision>
    <visual name="v">
      <geometry><mesh><uri>model://tennis_court/meshes/fence_long.dae</uri></mesh></geometry>
      <!-- Dark forest green — matches reference photo fence color -->
      <material>
        <ambient>0.06 0.16 0.08 0.88</ambient>
        <diffuse>0.08 0.20 0.10 0.88</diffuse>
        <specular>0.04 0.08 0.04 1</specular>
      </material>
    </visual>
  </link>

  <link name="fence_west">
    <pose>-14.5 0 0 0 0 -1.5708</pose>
    <collision name="col">
      <pose>0 0 2.0 0 0 0</pose>
      <geometry><box><size>15.0 0.08 4.0</size></box></geometry>
    </collision>
    <visual name="v">
      <geometry><mesh><uri>model://tennis_court/meshes/fence_long.dae</uri></mesh></geometry>
      <!-- Dark forest green — matches reference photo fence color -->
      <material>
        <ambient>0.06 0.16 0.08 0.88</ambient>
        <diffuse>0.08 0.20 0.10 0.88</diffuse>
        <specular>0.04 0.08 0.04 1</specular>
      </material>
    </visual>
  </link>

  <link name="fence_north">
    <pose>0 7.5 0 0 0 0</pose>
    <collision name="col">
      <pose>0 0 2.0 0 0 0</pose>
      <geometry><box><size>29.08 0.08 4.0</size></box></geometry>
    </collision>
    <visual name="v">
      <geometry><mesh><uri>model://tennis_court/meshes/fence_wide.dae</uri></mesh></geometry>
      <!-- Dark forest green — matches reference photo fence color -->
      <material>
        <ambient>0.06 0.16 0.08 0.88</ambient>
        <diffuse>0.08 0.20 0.10 0.88</diffuse>
        <specular>0.04 0.08 0.04 1</specular>
      </material>
    </visual>
  </link>

  <link name="fence_south">
    <pose>0 -7.5 0 0 0 0</pose>
    <collision name="col">
      <pose>0 0 2.0 0 0 0</pose>
      <geometry><box><size>29.08 0.08 4.0</size></box></geometry>
    </collision>
    <visual name="v">
      <geometry><mesh><uri>model://tennis_court/meshes/fence_wide.dae</uri></mesh></geometry>
      <!-- Dark forest green — matches reference photo fence color -->
      <material>
        <ambient>0.06 0.16 0.08 0.88</ambient>
        <diffuse>0.08 0.20 0.10 0.88</diffuse>
        <specular>0.04 0.08 0.04 1</specular>
      </material>
    </visual>
  </link>

  <!-- ── FLOODLIGHT POLES ─────────────────────────────────────────────── -->
  <link name="pole_ne"><pose>15.0 8.0 5.0 0 0 0</pose>
    <collision name="col"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry></collision>
    <visual name="v"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry>
      <material><ambient>0.35 0.35 0.40 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual></link>
  <link name="pole_nw"><pose>-15.0 8.0 5.0 0 0 0</pose>
    <collision name="col"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry></collision>
    <visual name="v"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry>
      <material><ambient>0.35 0.35 0.40 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual></link>
  <link name="pole_se"><pose>15.0 -8.0 5.0 0 0 0</pose>
    <collision name="col"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry></collision>
    <visual name="v"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry>
      <material><ambient>0.35 0.35 0.40 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual></link>
  <link name="pole_sw"><pose>-15.0 -8.0 5.0 0 0 0</pose>
    <collision name="col"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry></collision>
    <visual name="v"><geometry><cylinder><radius>0.06</radius><length>10.0</length></cylinder></geometry>
      <material><ambient>0.35 0.35 0.40 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual></link>

</model>
</sdf>
