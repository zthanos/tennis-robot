<?xml version="1.0"?>
<model>
  <name>tennis_robot</name>
  <version>1.0</version>
  <description>
    Mesh resources for the tennis robot. The robot itself is spawned from
    runtime/tennis_robot.sdf (generated by scripts/generate_robot_urdf.py);
    this model dir only provides model://tennis_robot/meshes/* resolution
    via GZ_SIM_RESOURCE_PATH. Meshes are copied from
    ros2_ws/src/tennis_robot/meshes/ (see scripts/generate_curved_scoop_mesh.py).
  </description>
</model>
