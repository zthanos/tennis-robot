<?xml version="1.0"?>
<!--
  Tennis Robot — Concept A
  Geometry extracted from worlds/tennis_court.wbt.

  Coordinate convention: X+ = forward, Y+ = left, Z+ = up  (standard ROS / Gazebo)

  Key dimensions:
    Chassis:       0.92 × 0.58 × 0.20 m, mass 8 kg
    Drive wheels:  radius 0.11 m, width 0.08 m, track 0.48 m (y = ±0.24), axle at x = −0.35
    Intake roller: radius 0.06 m, width 0.54 m, at x = +0.62
    Casters:       radius 0.055 m at x = +0.31, y = ±0.325
    LiDAR mast:    at x = −0.08, z = 0.72 (absolute from ground)
    Camera / Depth:at x = +0.535, z = 0.45, pitch +0.22 rad (12.6° down)
    IR intake:     at x = +0.54, y = ±0.105, z = 0.06

  Note: in the Webots world the motor named "left_wheel_motor" is physically on
  the robot's right (y = −0.24).  In this SDF the naming is corrected to match
  the ROS convention (left = +Y side).
-->
<sdf version="1.9">
<model name="tennis_robot">
  <pose>-8 0 0 0 0 0</pose>
  <self_collide>false</self_collide>

  <!-- ═══════════════════════════════════════════════════════ BASE LINK -->
  <link name="base_link">
    <pose>0 0 0.20 0 0 0</pose>
    <inertial>
      <mass>7.2</mass>
      <inertia>
        <ixx>0.22</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.38</iyy><iyz>0</iyz>
        <izz>0.42</izz>
      </inertia>
    </inertial>
    <collision name="chassis_col">
      <geometry><box><size>0.92 0.58 0.20</size></box></geometry>
    </collision>
    <!-- Plywood chassis — warm birch tone -->
    <visual name="chassis_vis">
      <geometry><box><size>0.92 0.58 0.20</size></box></geometry>
      <material>
        <ambient>0.62 0.44 0.26 1</ambient>
        <diffuse>0.68 0.50 0.30 1</diffuse>
        <specular>0.08 0.06 0.04 1</specular>
      </material>
    </visual>
    <!-- Electronics box — matte anthracite -->
    <visual name="elec_vis">
      <pose>-0.13 0 0.13 0 0 0</pose>
      <geometry><box><size>0.34 0.26 0.12</size></box></geometry>
      <material>
        <ambient>0.14 0.15 0.18 1</ambient>
        <diffuse>0.18 0.19 0.22 1</diffuse>
        <specular>0.15 0.15 0.16 1</specular>
      </material>
    </visual>
    <!-- Orange intake funnel -->
    <visual name="funnel_vis">
      <pose>0.52 0 -0.06 0 0 0</pose>
      <geometry><box><size>0.04 0.52 0.14</size></box></geometry>
      <material>
        <ambient>0.92 0.46 0.08 1</ambient>
        <diffuse>0.96 0.52 0.10 1</diffuse>
        <specular>0.10 0.06 0.02 1</specular>
      </material>
    </visual>
  </link>

  <!-- ═══════════════════════════════════════════════════════ LEFT WHEEL (y = +0.24) -->
  <!-- Cylinder r=0.11m h=0.08m mass=0.25kg, link rotated 90° around X so local Z = spin axis.
       Izz (spin) = 0.5*m*r² = 0.001513; Ixx=Iyy (transverse) = (1/12)*m*(3r²+h²) = 0.000889 -->
  <link name="left_wheel_link">
    <pose>-0.35 0.24 0.11 1.5708 0 0</pose>
    <inertial>
      <mass>0.25</mass>
      <inertia>
        <ixx>0.000889</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.000889</iyy><iyz>0</iyz>
        <izz>0.001513</izz>
      </inertia>
    </inertial>
    <collision name="col">
      <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
      <surface><friction><ode><mu>1.0</mu><mu2>0.5</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
    </collision>
    <visual name="vis">
      <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
      <material>
        <ambient>0.08 0.08 0.08 1</ambient>
        <diffuse>0.10 0.10 0.10 1</diffuse>
        <specular>0.20 0.20 0.20 1</specular>
      </material>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>left_wheel_link</child>
    <axis>
      <xyz expressed_in="__model__">0 1 0</xyz>
      <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      <dynamics><damping>0.001</damping></dynamics>
    </axis>
  </joint>

  <!-- ═══════════════════════════════════════════════════════ RIGHT WHEEL (y = −0.24) -->
  <link name="right_wheel_link">
    <pose>-0.35 -0.24 0.11 1.5708 0 0</pose>
    <inertial>
      <mass>0.25</mass>
      <inertia>
        <ixx>0.000889</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.000889</iyy><iyz>0</iyz>
        <izz>0.001513</izz>
      </inertia>
    </inertial>
    <collision name="col">
      <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
      <surface><friction><ode><mu>1.0</mu><mu2>0.5</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
    </collision>
    <visual name="vis">
      <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
      <material>
        <ambient>0.08 0.08 0.08 1</ambient>
        <diffuse>0.10 0.10 0.10 1</diffuse>
        <specular>0.20 0.20 0.20 1</specular>
      </material>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>right_wheel_link</child>
    <axis>
      <xyz expressed_in="__model__">0 1 0</xyz>
      <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      <dynamics><damping>0.001</damping></dynamics>
    </axis>
  </joint>

  <!-- ═══════════════════════════════════════════════════════ INTAKE ROLLER -->
  <link name="lift_wheel_link">
    <pose>0.62 0 0.065 1.5708 0 0</pose>
    <inertial>
      <mass>0.20</mass>
      <inertia>
        <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.001</iyy><iyz>0</iyz>
        <izz>0.001</izz>
      </inertia>
    </inertial>
    <collision name="col">
      <geometry><cylinder><radius>0.06</radius><length>0.54</length></cylinder></geometry>
      <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
    </collision>
    <visual name="vis">
      <geometry><cylinder><radius>0.06</radius><length>0.54</length></cylinder></geometry>
      <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
    </visual>
  </link>

  <joint name="lift_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>lift_wheel_link</child>
    <axis>
      <xyz expressed_in="__model__">0 1 0</xyz>
      <limit><lower>-1e16</lower><upper>1e16</upper></limit>
    </axis>
  </joint>

  <!-- ═══════════════════════════════════════════════════════ FRONT CASTERS (passive) -->
  <link name="front_left_caster_link">
    <pose>0.31 -0.325 0.055 0 0 0</pose>
    <inertial><mass>0.08</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia></inertial>
    <collision name="col">
      <geometry><sphere><radius>0.055</radius></sphere></geometry>
      <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
    </collision>
    <visual name="vis">
      <geometry><sphere><radius>0.055</radius></sphere></geometry>
      <material><ambient>0.05 0.05 0.05 1</ambient></material>
    </visual>
  </link>
  <joint name="front_left_caster_joint" type="ball">
    <parent>base_link</parent><child>front_left_caster_link</child>
  </joint>

  <link name="front_right_caster_link">
    <pose>0.31 0.325 0.055 0 0 0</pose>
    <inertial><mass>0.08</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia></inertial>
    <collision name="col">
      <geometry><sphere><radius>0.055</radius></sphere></geometry>
      <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
    </collision>
    <visual name="vis">
      <geometry><sphere><radius>0.055</radius></sphere></geometry>
      <material><ambient>0.05 0.05 0.05 1</ambient></material>
    </visual>
  </link>
  <joint name="front_right_caster_joint" type="ball">
    <parent>base_link</parent><child>front_right_caster_link</child>
  </joint>

  <!-- ═══════════════════════════════════════════════════════ LIDAR MAST -->
  <link name="lidar_link">
    <pose>-0.08 0 0.72 0 0 0</pose>
    <inertial><mass>0.05</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia></inertial>
    <visual name="mast_vis">
      <pose>0 0 -0.26 0 0 0</pose>
      <geometry><box><size>0.025 0.025 0.49</size></box></geometry>
      <material><ambient>0.20 0.22 0.26 1</ambient></material>
    </visual>
    <visual name="head_vis">
      <geometry><cylinder><radius>0.047</radius><length>0.045</length></cylinder></geometry>
      <material><ambient>0.025 0.03 0.035 1</ambient></material>
    </visual>

    <sensor name="front_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>31.25</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <topic>/gz/lidar</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>500</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265358979</min_angle>
            <max_angle>3.14159265358979</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
      </lidar>
    </sensor>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent>base_link</parent><child>lidar_link</child>
  </joint>

  <!-- ═══════════════════════════════════════════════════════ CAMERA -->
  <link name="camera_link">
    <!-- x=0.535, z=0.45 from ground (0.20+0.25), pitch 0.22 rad down -->
    <pose>0.535 0 0.45 0 0.22 0</pose>
    <inertial><mass>0.03</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia></inertial>
    <visual name="cam_vis">
      <geometry><box><size>0.04 0.10 0.04</size></box></geometry>
      <material><ambient>0.1 0.1 0.1 1</ambient></material>
    </visual>

    <sensor name="front_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>31.25</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <topic>/gz/camera</topic>
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
        <clip><near>0.08</near><far>18</far></clip>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
      </camera>
    </sensor>

    <sensor name="front_depth" type="depth_camera">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>31.25</update_rate>
      <always_on>true</always_on>
      <topic>/gz/depth</topic>
      <camera>
        <horizontal_fov>1.274</horizontal_fov>
        <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
        <clip><near>0.20</near><far>12</far></clip>
      </camera>
    </sensor>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent>base_link</parent><child>camera_link</child>
  </joint>

  <!-- ═══════════════════════════════════════════════════════ IR SENSORS (beam-break pair) -->
  <!-- IR left points in +Y direction (toward robot center from y=−0.105) -->
  <link name="ir_left_link">
    <pose>0.54 -0.105 0.06 0 0 -1.5708</pose>
    <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
    <sensor name="ir_left" type="gpu_lidar">
      <update_rate>31.25</update_rate>
      <always_on>true</always_on>
      <topic>/gz/ir_left</topic>
      <lidar>
        <scan>
          <horizontal><samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range><min>0.01</min><max>0.25</max><resolution>0.001</resolution></range>
      </lidar>
    </sensor>
  </link>
  <joint name="ir_left_joint" type="fixed">
    <parent>base_link</parent><child>ir_left_link</child>
  </joint>

  <!-- IR right points in −Y direction (toward robot center from y=+0.105) -->
  <link name="ir_right_link">
    <pose>0.54 0.105 0.06 0 0 1.5708</pose>
    <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
    <sensor name="ir_right" type="gpu_lidar">
      <update_rate>31.25</update_rate>
      <always_on>true</always_on>
      <topic>/gz/ir_right</topic>
      <lidar>
        <scan>
          <horizontal><samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range><min>0.01</min><max>0.25</max><resolution>0.001</resolution></range>
      </lidar>
    </sensor>
  </link>
  <joint name="ir_right_joint" type="fixed">
    <parent>base_link</parent><child>ir_right_link</child>
  </joint>

  <!-- ═══════════════════════════════════════════════════════ DIFF DRIVE -->
  <plugin filename="gz-sim-diff-drive-system"
          name="gz::sim::systems::DiffDrive">
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.48</wheel_separation>
    <wheel_radius>0.11</wheel_radius>
    <odom_publish_frequency>31.25</odom_publish_frequency>
    <topic>/cmd_vel</topic>
    <odom_topic>/odom</odom_topic>
    <tf_topic>/tf</tf_topic>
    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>
    <max_linear_acceleration>2.0</max_linear_acceleration>
    <min_linear_acceleration>-2.0</min_linear_acceleration>
    <max_angular_acceleration>4.0</max_angular_acceleration>
  </plugin>

  <!-- Intake roller velocity controller — topic /lift_wheel/cmd -->
  <plugin filename="gz-sim-joint-controller-system"
          name="gz::sim::systems::JointController">
    <joint_name>lift_wheel_joint</joint_name>
    <use_force_commands>false</use_force_commands>
    <topic>/lift_wheel/cmd</topic>
  </plugin>

</model>
</sdf>
