<?xml version="1.0"?>
<sdf version="1.11">
  <model name="tennis_ball_compliant">
    <pose>0 0 2.573 0 0 0</pose>
    <link name="ball_link">
      <inertial>
        <mass>0.058</mass>
        <!-- Thin-shell approximation I=2/3*m*r^2. -->
        <inertia><ixx>4.2108e-5</ixx><iyy>4.2108e-5</iyy><izz>4.2108e-5</izz></inertia>
      </inertial>
      <!-- Native collision remains only for cradle/unrelated category 0x0008.
           It cannot collide with analytical wheels (0x0002) or ground (0x0001). -->
      <collision name="cradle_only_collision">
        <geometry><sphere><radius>0.033</radius></sphere></geometry>
        <surface><contact><category_bitmask>4</category_bitmask><collide_bitmask>8</collide_bitmask></contact></surface>
      </collision>
      <visual name="ball_visual">
        <geometry><sphere><radius>0.033</radius></sphere></geometry>
        <material><ambient>0.75 0.88 0.08 1</ambient><diffuse>0.82 0.94 0.10 1</diffuse></material>
      </visual>
    </link>
    <plugin filename="tennis_ball_compliant_contact_system"
            name="tennis_ball_contact_system::TennisBallContactSystem">
      <ball_link>ball_link</ball_link>
      <left_wheel_link>flywheel_left_link</left_wheel_link>
      <right_wheel_link>flywheel_right_link</right_wheel_link>
      <ball_radius>0.033</ball_radius>
      <loading_exponent>1.5</loading_exponent>
      <unloading_exponent>1.9866353710127362</unloading_exponent>
      <loading_stiffness>107309.29404174259</loading_stiffness>
      <dynamic_damping>4692.375890562493</dynamic_damping>
      <maximum_compression>0.035</maximum_compression>
      <force_cap>5000.0</force_cap>
      <enable_ground>true</enable_ground><ground_height>0.0</ground_height>
      <telemetry_topic>/tennis_ball/compliant_contacts</telemetry_topic>
      <!-- friction_coefficient intentionally absent: physical launcher tyre
           friction calibration is pending, so no tangential force is invented. -->
    </plugin>
  </model>
</sdf>
