<?xml version="1.0"?>
<sdf version="1.9">
<world name="tennis_court">

  <!-- Physics — VER=21: step 0.004→0.002 (500 Hz), iters 50→100.
       DART's LCP contact solver may not converge at 250 Hz for high-friction
       wheel contacts. Finer steps give more solver iterations per real second
       and should reduce artificial slip from non-convergence.
       NOTE: this is live-mounted — no Docker rebuild needed. -->
  <physics name="ode" type="ode">
    <max_step_size>0.002</max_step_size>
    <real_time_factor>1.0</real_time_factor>
    <ode>
      <solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
      <constraints>
        <cfm>0</cfm>
        <erp>0.2</erp>
        <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
      </constraints>
    </ode>
  </physics>

  <!-- Required plugins -->
  <plugin filename="gz-sim-physics-system"       name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-sensors-system"        name="gz::sim::systems::Sensors">
    <render_engine>ogre</render_engine>
  </plugin>
  <plugin filename="gz-sim-imu-system"            name="gz::sim::systems::Imu"/>
  <plugin filename="gz-sim-contact-system"       name="gz::sim::systems::Contact"/>

  <!-- Morning sun ~10:00 — low angle, strong Mediterranean light, sharp shadows -->
  <light type="directional" name="sun">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 100 0 0 0</pose>
    <diffuse>1.0 0.90 0.74 1</diffuse>
    <specular>0.28 0.22 0.14 1</specular>
    <direction>-0.55 0.30 -0.78</direction>
  </light>

  <!-- Cool sky fill (simulates light from the open sky opposite the sun) -->
  <light type="directional" name="sky_fill">
    <cast_shadows>false</cast_shadows>
    <pose>0 0 50 0 0 0</pose>
    <diffuse>0.22 0.30 0.46 1</diffuse>
    <specular>0.03 0.04 0.06 1</specular>
    <direction>0.45 -0.25 -0.86</direction>
  </light>

  <scene>
    <ambient>0.35 0.32 0.26 1</ambient>
    <background>0.58 0.72 0.90 1</background>
    <shadows>true</shadows>
    <grid>false</grid>
  </scene>

  <!-- Court -->
  <include>
    <uri>model://tennis_court</uri>
    <pose>0 0 0 0 0 0</pose>
  </include>

  <!-- ── TENNIS BALLS ── radius 0.033 m, mass 0.058 kg ─────────── -->
  <!-- Positions extracted from worlds/tennis_court.wbt -->
  <model name="ball_00"><pose>-4.264 -3.713 0.033 0 0 0</pose>
    <link name="ball"><inertial><mass>0.058</mass><inertia><ixx>2.5e-5</ixx><iyy>2.5e-5</iyy><izz>2.5e-5</izz></inertia></inertial>
    <collision name="col"><geometry><sphere><radius>0.033</radius></sphere></geometry><surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface></collision>
    <visual name="vis"><geometry><sphere><radius>0.033</radius></sphere></geometry><material><ambient>0.8 0.9 0.1 1</ambient><diffuse>0.8 0.9 0.1 1</diffuse></material></visual>
    </link></model>

