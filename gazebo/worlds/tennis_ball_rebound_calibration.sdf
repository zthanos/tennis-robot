<?xml version="1.0"?>
<sdf version="1.11">
  <world name="tennis_ball_rebound_calibration">
    <physics name="dart_calibration" type="dart">
      <max_step_size>0.00025</max_step_size><real_time_factor>1</real_time_factor>
      <dart><collision_detector>ode</collision_detector><solver><solver_type>dantzig</solver_type></solver></dart>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-dartsim-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.80665</gravity>
    <model name="calibration_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
          <surface><contact><category_bitmask>1</category_bitmask><collide_bitmask>1</collide_bitmask></contact></surface>
        </collision>
        <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry></visual>
      </link>
    </model>
    <!-- Bottom of the nominal 66 mm ball starts 2.54 m above the surface. -->
    <include><uri>model://tennis_ball_compliant</uri><name>calibration_ball</name><pose>0 0 2.573 0 0 0</pose></include>
  </world>
</sdf>
