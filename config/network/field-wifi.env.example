# Tennis Robot field access-point configuration.
#
# Copy this file outside the repository and protect it before adding a real
# passphrase:
#   sudo install -m 0600 config/network/field-wifi.env.example \
#     /etc/tennis-robot/field-wifi.env
#   sudoedit /etc/tennis-robot/field-wifi.env

FIELD_WIFI_SSID="TennisRobot"
FIELD_WIFI_PASSPHRASE="REPLACE_WITH_A_UNIQUE_RANDOM_PASSPHRASE"

# Non-secret defaults. The installer can auto-detect the first Wi-Fi device.
FIELD_WIFI_CONNECTION="tennis-robot-field-ap"
FIELD_WIFI_INTERFACE=""
FIELD_WIFI_ADDRESS="10.42.0.1/24"
FIELD_WIFI_BAND="bg"
# Fixed non-overlapping 2.4 GHz channel for predictable phone compatibility.
FIELD_WIFI_CHANNEL="6"
# Supported values: wpa-psk (WPA2, broad phone compatibility) or sae (WPA3).
FIELD_WIFI_SECURITY="wpa-psk"
